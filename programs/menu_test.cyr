# programs/menu_test.cyr — RUN test for MENU (0.9.23): items, separators, the inert rules, and the
# height derivation that scrolling cannot do.
# Exit code = failed checks.
#
# ⚠ THE INTERESTING CASES ARE THE SEPARATORS. A menu of plain items behaves exactly like the LIST it
# is; every bug lives in the row that must be skipped by the keyboard, missed by the mouse, and
# counted by the height.

include "src/lib.cyr"

var g_fails = 0;

fn check(got, want): i64 {
    if (got == want) { return 0; }
    g_fails = g_fails + 1;
    return 1;
}

fn main(): i64 {
    alloc_init();
    rupa_theme_set_active_name("mudra-dark");

    var spec = dh_cols_new(2);
    dh_cols_reset(spec, 2);
    dh_cols_set_width(spec, 0, 0);        # the label — the remainder column
    dh_cols_set_width(spec, 1, 60);       # the accelerator

    var m = dh_menu_new(22);
    check(dh_menu_item(m, spec, "Open", "Enter") != 0, 1);
    check(dh_menu_item(m, spec, "Rename", "F2") != 0, 1);
    check(dh_menu_sep(m) != 0, 1);
    check(dh_menu_item(m, spec, "Delete", "Del") != 0, 1);
    # ⚠ An item with no accelerator is legal — the column is still reserved so every label starts at
    # the same x.
    check(dh_menu_item(m, spec, "Properties", 0) != 0, 1);
    check(dh_list_count(m), 5);

    # ---- the separator is INERT: unselectable, unhittable, skipped by the keyboard ----------------
    # ⛔ A separator that could be selected is a menu that highlights a horizontal line when you press
    # Down; one that could be hit is a menu that closes on a click that pointed at nothing.
    check(dh_list_select(m, 2), 0 - 1);              # index 2 is the separator — REFUSED
    check(dh_list_selected(m), 0 - 1);               # ...and nothing became selected
    check(dh_list_select(m, 1), 1);                  # a real item selects fine
    # Down from item 1 must land on 3, stepping OVER the separator at 2.
    check(dh_list_move_sel(m, 1), 3);
    # ...and Up from 3 must land back on 1, not on 2.
    check(dh_list_move_sel(m, 0 - 1), 1);
    # ⚠ From NO selection, either direction lands on the first SELECTABLE row.
    dh_list_select(m, 0 - 1);
    check(dh_list_move_sel(m, 1), 0);
    # ⛔ A menu whose LAST row is a separator must not trap the cursor there.
    var m2 = dh_menu_new(22);
    dh_menu_item(m2, spec, "One", 0);
    dh_menu_sep(m2);
    dh_list_select(m2, 0);
    check(dh_list_move_sel(m2, 1), 0);               # cannot move onto the trailing separator
    # ⚠ ...and a menu that is ONLY separators terminates rather than spinning.
    var m3 = dh_menu_new(22);
    dh_menu_sep(m3);
    dh_menu_sep(m3);
    check(dh_list_select(m3, 0), 0 - 1);
    check(dh_list_move_sel(m3, 1), 0 - 1);

    # ---- the height sums the CHILDREN, because separators are not row_h tall ----------------------
    # ⛔ `dh_list_content_h` assumes uniform rows and is wrong by the separator's extra height for
    # every separator present. Two derivations of one number is the bug this replaces.
    # 4 items x 22 + 1 sep x 9 = 97, + 4 gaps x 1 = 101, + 2 x 5 padding = 111.
    check(dh_menu_pref_h(m), 111);
    # A menu with no separators agrees with the uniform-row arithmetic, which is the control.
    var m4 = dh_menu_new(20);
    dh_menu_item(m4, spec, "A", 0);
    dh_menu_item(m4, spec, "B", 0);
    check(dh_menu_pref_h(m4), 51);                   # 2*20 + 1 gap + 10 pad
    check(dh_menu_pref_h(0), 0);                     # a null menu has no height, not a fault

    # ---- hit-testing lands on the item under the pointer, and -1 on a separator -------------------
    var root = dh_widget_new(WINDOW);
    dh_widget_set_layout(root, NONE);
    var layer = dh_overlay_new();
    dh_widget_set_pref(m, 160, dh_menu_pref_h(m));
    dh_widget_set_offset(m, 10, 10);
    dh_widget_add_child(layer, m);
    dh_widget_add_child(root, layer);
    dh_layout_apply(root, 300, 300);
    check(dh_widget_x(m), 10);
    check(dh_widget_y(m), 10);
    # Row 0 starts below the 5px padding: y = 10 + 5 = 15.
    check(dh_list_index_at(m, 20, 20), 0);
    # ⛔ The separator's band answers -1, NOT the row above it. The operator pointed at a gap, and
    # acting on the neighbouring item is worse than not acting.
    var sepy = dh_widget_y(dh_list_row_at(m, 2)) + 4;
    check(dh_list_index_at(m, 20, sepy), 0 - 1);
    # ...and the item after the separator is reachable.
    var afy = dh_widget_y(dh_list_row_at(m, 3)) + 4;
    check(dh_list_index_at(m, 20, afy), 3);

    # ---- the panel has a border and the theme's panel ground -------------------------------------
    check(dh_widget_border(m), dh_theme_line());
    check(dh_widget_bg(m), dh_theme_panel());
    # ⚠ ...and it FOLLOWS the theme rather than freezing it, which is what `dh_widget_border` storing
    # a resolved colour would break. Re-reading under a second palette is the only check that catches
    # a colour captured at construction.
    var darkline = dh_theme_line();
    rupa_theme_set_active_name("shanta-light");
    var m5 = dh_menu_new(20);
    check(dh_widget_border(m5) == darkline, 0);
    check(dh_widget_border(m5), dh_theme_line());
    rupa_theme_set_active_name("mudra-dark");

    if (g_fails == 0) {
        println("menu_test: PASS (items, separators, inert selection + hit, height, theme)");
        return 0;
    }
    println("menu_test: FAIL");
    return g_fails;
}

var rc = main();
syscall(60, rc);
