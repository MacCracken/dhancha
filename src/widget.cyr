# @public — dhancha widget-tree model.
# widget.cyr — DhWidget: the retained-mode widget node.
#
# A DhWidget is the unit of the UI tree. Nodes form a first-child /
# next-sibling tree (the classic space-efficient n-ary tree encoding),
# so a parent holds one child pointer and children chain via siblings.
# Layout (layout.cyr) walks the tree to assign bounds; event dispatch
# (event.cyr) hit-tests it; the surface (surface.cyr) draws it.
#
# DhWidget struct layout (288 bytes, 36 u64 slots — see `DH_WIDGET_SIZE` below):
# ⚠ THIS HEADER READ "144 bytes, 18 u64 slots" UNTIL 0.9.22 while the field list below it already
# ran past +168. It contradicted itself and understated the record by 112 bytes, which is exactly
# how a reader sizing a NEW field off the header picks an offset that collides with a live one.
# ⇒ Re-derive it from the enum, not from this line, and update it when the enum grows.
#   +0:   id            — monotonic widget id (debug / focus routing)
#   +8:   kind          — one of DhWidgetKind
#   +16:  x             — resolved x (layout output)
#   +24:  y             — resolved y
#   +32:  w             — resolved width
#   +40:  h             — resolved height
#   +48:  parent        — parent DhWidget* (0 = root)
#   +56:  first_child   — first child DhWidget* (0 = leaf)
#   +64:  next_sibling  — next sibling under the same parent (0 = last)
#   +72:  layout        — DhLayout mode applied to this node's children
#   +80:  bg            — background color 0x00RRGGBB, or -1 = none
#   +88:  text          — cstring ptr for LABEL / BUTTON, or 0
#   +96:  pref_w        — requested width (layout hint)
#   +104: pref_h        — requested height
#   +112: handler       — bubble-phase handler fnptr `handler(wgt, ev) -> consumed`, or 0
#   +120: userdata      — opaque app context the handler reads back, or 0
#   +128: capture_h     — capture-phase handler fnptr (fires root->target first), or 0
#   +136: flags         — bitmask: DH_FLAG_DRAGGABLE | DH_FLAG_DROP_TARGET
#   +144: flex          — flex weight for BOX layout (0 = fixed, use pref size)
#   +152: pad           — uniform padding inside this container (px)
#   +160: gap           — spacing between this container's children (px)
#   +168: align         — cross-axis align-self (DhAlign; 0 = STRETCH)

enum DhWidgetKind {
    WINDOW    = 0;
    BOX       = 1;
    LABEL     = 2;
    BUTTON    = 3;
    TEXTINPUT = 4;
    LIST      = 5;   # ⭐ 0.9.7 — a SCROLLING, SELECTABLE container. See list.cyr.
    CANVAS    = 6;   # ⭐ 0.9.9 — APP-DRAWN content in a widget-tree slot. See canvas.cyr.
    PROGRESS  = 7;   # ⭐ 0.9.22 — a DETERMINATE-or-INDETERMINATE bar. See progress.cyr.
    # ⭐⭐ 0.9.25 — a WRAPPING, SELECTABLE grid of fixed-size cells. See grid.cyr.
    # ⛔ IT EARNS A KIND BY THIS REPO'S OWN RULE, stated in `progress.cyr`'s header and applied when
    # MENU and SHEET were REFUSED one in 0.9.23: *a kind earns itself only when composing it would
    # force the APP to name a theme colour, or when it expresses state no existing kind can hold.*
    # A grid composed from BOXes clears both bars — the app would have to paint the selected cell's
    # highlight itself, which means naming `accent`, which crab's ADR 0001 forbids outright; and the
    # wrapping arithmetic (how many cells fit this width) is the rule that "lived in three apps"
    # which is why LIST exists at all.
    # ⚠ Deliberately NOT a new DhLayout mode. Wrapping is inseparable from the cell size and the
    # selection here, and a BOX that wrapped would change what every existing BOX means.
    GRID      = 8;
}

# Field offsets (bytes) into a DhWidget record.
enum DhWidgetField {
    DH_W_ID           = 0;
    DH_W_KIND         = 8;
    DH_W_X            = 16;
    DH_W_Y            = 24;
    DH_W_W            = 32;
    DH_W_H            = 40;
    DH_W_PARENT       = 48;
    DH_W_FIRST_CHILD  = 56;
    DH_W_NEXT_SIBLING = 64;
    DH_W_LAYOUT       = 72;    # DhLayout mode applied to this node's children
    DH_W_BG           = 80;    # background color 0x00RRGGBB, or -1 = none
    DH_W_TEXT         = 88;    # cstring ptr for LABEL / BUTTON, or 0
    DH_W_PREF_W       = 96;    # requested width (layout hint)
    DH_W_PREF_H       = 104;   # requested height
    DH_W_HANDLER      = 112;   # bubble-phase handler fnptr, or 0
    DH_W_USERDATA     = 120;   # opaque app context for the handler, or 0
    DH_W_CAPTURE_H    = 128;   # capture-phase handler fnptr, or 0
    DH_W_FLAGS        = 136;   # bitmask (DH_FLAG_*)
    DH_W_FLEX         = 144;   # flex weight (0 = fixed)
    DH_W_PAD          = 152;   # uniform content padding (px)
    DH_W_GAP          = 160;   # spacing between children (px)
    DH_W_ALIGN        = 168;   # cross-axis align-self (DhAlign)
    # ⭐⭐ PER-WIDGET MOTION OVERRIDE (0.9.6). The system GRANTS a vocabulary in rupa; a widget may ask
    # for something else, and rupa's clamp decides what it actually gets. Storing the ASK rather than
    # the resolved value is deliberate: the answer depends on the reduced-motion switch, which can flip
    # at runtime, so resolving at set-time would freeze an accessibility decision into every widget.
    DH_W_MO_ROLE      = 176;   # RupaMotion role this widget moves with (default RU_MO_QUICK)
    DH_W_MO_MS        = 184;   # requested duration override, 0 = none (take the grant)
    DH_W_MO_EASE      = 192;   # requested easing override, -1 = none
    # ⭐ SCROLL + SELECTION (0.9.7). On ANY container, not just LIST — a scrolled BOX is the same
    # arithmetic, and gating it on kind would mean a second code path for "a box that happens to
    # scroll". `list.cyr` adds the policy (clamping, keep-selected-visible); these are just the state.
    DH_W_SCROLL_Y     = 200;   # px this container's content is shifted UP by. >= 0. 0 = at the top.
    DH_W_SEL          = 208;   # selected child index, or -1 = nothing selected
    # ⭐ EDITABLE TEXT (0.9.7). The buffer itself is `DH_W_TEXT` — the SAME field a LABEL uses — so
    # the existing draw path renders a TEXTINPUT's contents with no new painting code. These three
    # are what make it editable rather than static.
    DH_W_TEXT_CAP     = 216;   # buffer capacity in BYTES, including the NUL. 0 = not editable.
    DH_W_TEXT_LEN     = 224;   # bytes currently used, excluding the NUL
    DH_W_CARET        = 232;   # caret position as a BYTE offset into the buffer, 0..len
    # ⭐ CANVAS DRAW CALLBACK (0.9.9) — `draw(wgt, sds, clx, cly, clw, clh)`, or 0.
    DH_W_DRAW         = 240;
    # ⭐ PER-WIDGET TEXT COLOUR (0.9.20). -1 = inherit from the parent, which is what every widget
    # did unconditionally before. Appended at the end so every offset above is unchanged.
    # ⛔ IT DOES NOT OUTRANK THE SELECTION HIGHLIGHT. A cell's colour is a PREFERENCE; on-accent on a
    # selected row is a LEGIBILITY GUARANTEE, and a table that let a column set its own colour would
    # otherwise be able to make the selected row unreadable again — the exact defect 0.9.20 fixed.
    DH_W_FG           = 248;
    # ⭐ PROGRESS FILL (0.9.22). How full the bar is, in PERMILLE (0..1000), or -1 = INDETERMINATE.
    # Appended at the end so every offset above is unchanged — consumers read these offsets straight
    # out of the fold, and inserting in the middle would silently re-point every field after it.
    # ⛔ SEEDED TO -1, NOT 0, AND IT IS THE SAME TRAP AS `DH_W_SEL`: 0 is a VALID fill ("started,
    # nothing done yet"), so a zeroed field would make every bar in the system claim a real 0%
    # rather than admit it has not been told anything. And the allocation is NOT guaranteed zeroed:
    # under the frame arena the memory is RECYCLED from a previous frame's widgets, so an unseeded
    # field carries a *plausible* stale permille instead of an obvious zero.
    DH_W_FILL         = 256;
    # ⭐ OVERLAY OFFSET (0.9.23). How far this child sits from its NONE container's PADDED CONTENT
    # ORIGIN, in px. 0,0 is the origin — exactly where every child sat before — so every existing
    # NONE container is bit-identical.
    # ⛔ NONE CONTAINERS ONLY, DELIBERATELY. An offset honoured inside a BOX_H/BOX_V would be a
    # MARGIN wearing the wrong name: the flex distributor does not account for it, so the child would
    # overlap its neighbour and the container's measured size would be a lie. Same reasoning that
    # keeps `DH_W_SCROLL_Y` vertical-only — a field that means one thing.
    # ⛔ SEEDED EXPLICITLY EVEN THOUGH 0 IS THE DEFAULT. Under the frame arena the memory is
    # RECYCLED, so an unseeded offset carries a previous frame's value — and that value is a SMALL
    # PLAUSIBLE NUMBER, which is the worst kind of wrong: a popup 40 px from where it was asked for
    # reads as a design decision, not a fault.
    DH_W_OFF_X        = 264;
    DH_W_OFF_Y        = 272;
    # ⭐ PER-WIDGET BORDER (0.9.23). A sadish colour, or one of the two sentinels in `DhBorder`.
    # ⛔ WHY TWO SENTINELS. -1 cannot mean "none", because -1 is also what a BUTTON has by default and
    # a BUTTON's default is `line`. A single sentinel would make `set_border(btn, -1)` mean "restore
    # the border" when the caller plainly meant "remove it".
    # ⛔ THE COLOUR IS RESOLVED AT DRAW TIME, NEVER AT CONSTRUCTION. Storing `dh_theme_line()` here
    # would freeze the palette into every widget, so a theme switch would leave already-built widgets
    # on the old colour — and it would make widget.cyr call into theme.cyr, which sits AFTER it in
    # the fold.
    DH_W_BORDER       = 280;
    # ⭐⭐ THE STABLE KEY (0.9.24) — a caller-supplied identity that survives a frame arena rewind.
    #
    # ⛔⛔ THE PROBLEM IT SOLVES: dhancha identified a widget by its POINTER, and a per-frame arena
    # invalidates every pointer at `dh_frame_begin`. Four features are built on retained widget
    # pointers — focus, hover, press and drag — so all four were unreachable from an immediate-mode
    # app that rebuilds its tree each frame. `dh_dispatch`, drag and `TEXTINPUT` were each worked
    # around separately in crab before anyone noticed the three had **one** cause.
    # ⇒ A key is an ordinary integer, so `arena_reset` cannot invalidate it. The app labels the
    # widgets it wants remembered, dhancha remembers KEYS instead of pointers, and
    # `dh_surface_set_root` re-resolves key → widget against the newly built tree each frame.
    #
    # ⚠ **0 MEANS "NO STABLE IDENTITY", AND THAT IS WHY THIS IS ADDITIVE.** Every widget that exists
    # today has key 0, retained state falls back to raw pointers exactly as before, and no shipped
    # app changes behaviour. A key is opt-in per widget, not per app.
    # ⚠ KEYS ARE THE APP'S NAMESPACE, NOT dhancha's. `DH_W_ID` is a monotonic counter minted per
    # allocation — it is *fresh every frame* under an arena and therefore useless as identity. The
    # key is whatever the app can re-derive: a pane index, a row index, a hash of a path.
    # ⛔ UNIQUENESS IS THE APP'S CONTRACT. `dh_widget_find_key` returns the FIRST match in
    # depth-first order; two widgets sharing a key is a bug in the app and dhancha cannot detect it
    # cheaply. Said here rather than enforced, because the check is O(n²) on every frame.
    DH_W_KEY          = 288;
    # ⭐ GRID cell geometry (0.9.25). ⛔ NOT folded onto `DH_W_PREF_W` / `_PREF_H`: those are the
    # grid's OWN preferred size, which layout reads and writes, so a grid that stored its cell size
    # there could not also be sized by its parent. ⚠ LIST overloads `DH_W_PREF_H` as its row height
    # and gets away with it because a list has no cross-axis cell size to keep; a grid has both.
    DH_W_CELL_W       = 296;
    DH_W_CELL_H       = 304;
    # ⭐⭐ HORIZONTAL SCROLL (0.9.25+1). ⛔ ITS OWN FIELD, EXACTLY AS `layout.cyr` PROMISED. That file
    # has said since 0.9.7: *"Horizontal scrolling is not implemented; when it is, it gets its own
    # field rather than a reinterpretation of this one."* Reusing `DH_W_SCROLL_Y` for a row would be
    # a horizontal scroll wearing a field named `scroll_y` — a silent lie at every call site.
    DH_W_SCROLL_X     = 312;
}
# ⚠ 256 -> 264 at 0.9.22. A consumer with a FIXED-size arena sized against the old footprint will
# now spill to the global allocator, and `dh_falloc` degrades to a leak rather than to a null — so
# it passes every functional test and shows up only in an `alloc_used()` convergence check. crab is
# safe (`arena_new_growable`, which chains); check any other consumer before shipping.
# ⚠ 320 as of 0.9.26 (288 at 0.9.23, 296 at 0.9.24, 312 at 0.9.25) — `DH_W_KEY`, `DH_W_CELL_W` /
# `_CELL_H`, then `DH_W_SCROLL_X`.
# ⛔ This constant and the layout above must move together; the header comment has been stale before,
# so re-derive it from the last field rather than trusting either. ⭐ `progress_test` pins the value
# as a literal precisely so a change here has to be confirmed by a human — it has fired three times.
var DH_WIDGET_SIZE = 320;

# ============================================================================================
# ⭐⭐ MOTION — the app's half of "the compositor grants, apps override per widget"
# ============================================================================================
# ⛔ EVERY READ GOES THROUGH rupa's CLAMP. These accessors deliberately expose no way to get the raw
# request back out for use: `dh_widget_motion_ms` is the only path to a number a caller can animate
# with, and it calls `rupa_motion_duration`, which enforces the flash-band floor and lets the
# reduced-motion switch outrank the widget. A convenience getter returning the unclamped ask would be
# used by accident and would route around the guards — which is why one does not exist.
fn dh_widget_set_motion(w, role, want_ms, want_ease): i64 {
    if (w == 0) { return 0 - 1; }
    store64(w + DH_W_MO_ROLE, role);
    store64(w + DH_W_MO_MS, want_ms);
    store64(w + DH_W_MO_EASE, want_ease);
    return 0;
}
fn dh_widget_motion_role(w): i64 { if (w == 0) { return RupaMotion.RU_MO_QUICK; } return load64(w + DH_W_MO_ROLE); }

# The duration this widget must actually animate with, in ms. -> already clamped; use it as given.
fn dh_widget_motion_ms(w): i64 {
    if (w == 0) { return 0; }
    return rupa_motion_duration(load64(w + DH_W_MO_ROLE), load64(w + DH_W_MO_MS));
}
# The easing this widget must actually use.
fn dh_widget_motion_ease(w): i64 {
    if (w == 0) { return RupaEase.RU_EASE_LINEAR; }
    return rupa_motion_ease(load64(w + DH_W_MO_ROLE), load64(w + DH_W_MO_EASE));
}
# How far through, at `elapsed_ms`. Periodic roles cycle; the rest run once and finish.
# ⚠ ROUTED BY ROLE, not by a caller's guess: a consumer choosing `progress` for a BUSY widget would get
# a spinner that completes once and stops, which reads as the work having finished.
fn dh_widget_motion_at(w, elapsed_ms): i64 {
    if (w == 0) { return 255; }
    var d = dh_widget_motion_ms(w);
    var e = dh_widget_motion_ease(w);
    if (rupa_motion_is_periodic(load64(w + DH_W_MO_ROLE)) == 1) { return rupa_motion_cycle(d, elapsed_ms, e); }
    return rupa_motion_progress(d, elapsed_ms, e);
}

# Widget behavior flags (DH_W_FLAGS bitmask).
enum DhWidgetFlag {
    DH_FLAG_DRAGGABLE   = 1;    # a press + drag on this widget starts a drag
    DH_FLAG_DROP_TARGET = 2;    # a drag released over this widget drops onto it
    # ⭐ 0.9.23 — PAINT ONLY, no input meaning. This widget's rect is SCANLINE-DIMMED with
    # `dh_theme_bg()` before its children draw. See `dh_draw_scrim`, and the ⛔ there about what
    # sadish can and cannot actually do.
    DH_FLAG_SCRIM       = 4;
    # ⭐ 0.9.23 — INPUT + SELECTION ONLY, no paint. A container child that cannot be selected and
    # cannot be hit AS A ROW: a menu separator, a section heading inside a list.
    # ⚠ Additive — no widget that exists today sets this bit, so every shipped LIST is unchanged.
    DH_FLAG_INERT       = 8;
}

# Border sentinels. ⛔ TWO, NOT ONE — see the ⛔ at `DH_W_BORDER`.
enum DhBorder {
    DH_BORDER_INHERIT = -1;      # take this KIND's default (BUTTON -> line; everything else -> none)
    DH_BORDER_NONE    = -2;      # draw nothing, whatever the kind
}

# Cross-axis alignment of a child within its BOX container's cross size
# (align-self). STRETCH (the default) fills the cross axis; the others use
# the child's preferred cross size and position it.
enum DhAlign {
    ALIGN_STRETCH = 0;
    ALIGN_START   = 1;
    ALIGN_CENTER  = 2;
    ALIGN_END     = 3;
}

# ============================================================================================
# ⭐⭐ THE PER-FRAME ARENA (0.9.15) — how an immediate-mode toolkit stops leaking a tree a frame
# ============================================================================================
# ⛔ THE PROBLEM IS THE SUBSTRATE, NOT THE TOOLKIT'S STYLE. `lib/alloc.cyr` is a bump allocator with
# **no `free()`**; `alloc_reset` rewinds the WHOLE arena and would take the caller's own long-lived
# objects with it. So an app that rebuilds its widget tree every frame — which is what immediate-mode
# means, and what makes toolkit-owned selection and scroll work at all — retains every widget it has
# ever built, for the life of the process. Measured against crab at 380x220 with 114 entries per pane:
# **~236 widgets x 288 B = 67,968 B per frame**, permanently. (248 B until 0.9.22; the figure moves
# with `DH_WIDGET_SIZE` and has been stale before — re-derive it rather than trusting it.)
#
# ⇒ Route the PER-FRAME allocations through a caller-supplied arena. `arena_reset` is a bump back to
# base with no free list, and a GROW arena keeps its chunks across resets — so a render loop converges
# on its high-water mark and then **allocates nothing at all**.
#
# ⛔⛔ WHAT IS AND IS NOT ROUTED HERE IS A SAFETY BOUNDARY, NOT A COMPLETENESS ONE. dhancha calls
# `alloc()` at 19 sites and only the per-frame ones may move:
#   ROUTED  — `dh_widget_new` (this file) and layout's measure scratch (`layout.cyr`). Both die with
#             the frame by construction.
#   NOT     — `dh_surface_new` and its pixels, the setu client's shared buffer, event records and
#             queues, textinput text buffers, canvas surfaces, error records. **Every one of these
#             outlives a frame**, and a caller holds pointers to them across resets. Routing
#             `dh_surface_new` in particular would free crab's session surface out from under it on
#             the first reset — a use-after-free that the bump allocator would then hand back out,
#             so it would corrupt silently rather than fault.
#
# ⚠ EXHAUSTION DEGRADES TO A LEAK, NEVER TO A NULL DEREF. `dh_falloc` falls back to the global
# allocator when the arena refuses. The stdlib's own arena notes diagnose why this matters: a 0 from
# `arena_alloc` is indistinguishable from a valid pointer and faults several layers away, so
# "adopting the feature made the failure worse and quieter". A dropped widget is a corrupted frame;
# a spilled one is merely the cost we had before. ⭐ Callers should still prefer
# `arena_new_growable`, which chains a chunk instead of refusing and never reaches this fallback.
#
# ⛔ RESETTING INVALIDATES EVERY WIDGET POINTER — INCLUDING THE FOUR DHANCHA ITSELF HOLDS.
# `_dh_focus`, `_dh_hover`, `_dh_press` and `_dh_drag_src` (event.cyr) are raw widget pointers kept
# across calls. After a reset they address memory the arena is about to hand out again, so a
# `dh_focus_within` walk would follow recycled parent links. That is why the reset entry point is
# `dh_frame_begin` (event.cyr) — it resets the arena AND clears those four, and the two halves cannot
# be done separately. **Do not call `arena_reset` on a frame arena directly.**
var _dh_frame_arena = 0;

# @public — route dhancha's per-frame allocations through arena `a`. Pass 0 to go back to the global
# allocator, which is the default and is exactly the pre-0.9.15 behaviour.
fn dh_frame_arena_set(a): i64 { _dh_frame_arena = a; return DHANCHA_OK; }

# @public — the arena currently backing per-frame allocations, or 0 for the global allocator.
fn dh_frame_arena_get(): i64 { return _dh_frame_arena; }

# @public — allocate `size` bytes that live only until the next `dh_frame_begin`. Consumers may use
# this for their own per-frame scratch: a row's display string handed to `dh_widget_set_text` MUST
# share the widget's lifetime, because `set_text` stores the pointer and does not copy.
# ⚠ Falls back to the global allocator when no arena is set or the arena refuses — see the ⛔ above.
fn dh_falloc(size): i64 {
    if (_dh_frame_arena == 0) { return alloc(size); }
    var p = arena_alloc(_dh_frame_arena, size);
    if (p == 0) { return alloc(size); }
    return p;
}

# Monotonic widget-id source. A plain module-global SCALAR (not a `[1]` array —
# module-global `var X[N]` sizing is non-uniform in cyrius, so an 8-byte
# load64/store64 on a `[1]` can read/write out of bounds). A scalar i64 is a
# reliable 8-byte cell accessed directly.
var _dh_next_widget_id = 0;

# @public — give this widget a stable identity that survives a frame-arena rewind. See `DH_W_KEY`.
# ⚠ `key == 0` clears it, which is the default and means "not remembered across frames".
fn dh_widget_set_key(w, key): i64 {
    if (w == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(w + DH_W_KEY, key);
    return DHANCHA_OK;
}

# @public — this widget's stable key, or 0 if it has none.
fn dh_widget_key(w): i64 {
    if (w == 0) { return 0; }
    return load64(w + DH_W_KEY);
}

# @public — find the widget carrying `key` in the subtree rooted at `root`. -> DhWidget*, or 0.
#
# ⛔ DEPTH-FIRST, FIRST MATCH WINS, AND IT DOES NOT PRUNE. This is deliberately unlike
# `dh_hit_test`, which prunes any subtree whose root does not contain the point: a key is an
# identity, not a location, so a keyed widget laid out anywhere — scrolled out of view, offset into
# an overlay, sized to nothing — must still be findable. Pruning here would make focus silently
# unrecoverable for exactly the widgets an app is most likely to key.
# ⚠ `key == 0` finds nothing, because 0 is the "no identity" sentinel and every unkeyed widget in
# the tree carries it. Answering with the first unkeyed widget would be worse than answering none.
fn dh_widget_find_key(root, key): i64 {
    if (root == 0) { return 0; }
    if (key == 0) { return 0; }
    if (load64(root + DH_W_KEY) == key) { return root; }
    var c = load64(root + DH_W_FIRST_CHILD);
    while (c != 0) {
        var hit = dh_widget_find_key(c, key);
        if (hit != 0) { return hit; }
        c = load64(c + DH_W_NEXT_SIBLING);
    }
    return 0;
}

# Allocate + zero-init a widget of the given kind. Returns a DhWidget*.
# All bounds start at 0 (layout fills them in); tree links start null.
fn dh_widget_new(kind): i64 {
    # ⚠ `dh_falloc`, not `alloc` (0.9.15) — the widget tree is the per-frame allocation. See the ⛔
    # block above `_dh_frame_arena` for what may and may not move onto the arena, and why.
    var wgt = dh_falloc(DH_WIDGET_SIZE);
    var id = _dh_next_widget_id;
    _dh_next_widget_id = id + 1;
    store64(wgt + DH_W_ID, id);
    store64(wgt + DH_W_KIND, kind);
    # ⭐ MOTION DEFAULTS: inherit the system's QUICK grant, override nothing. ⛔ `DH_W_MO_EASE` must be
    # **-1**, not 0 — 0 is `RU_EASE_LINEAR`, a real value, so a zeroed field would silently mean "this
    # widget overrides the easing to linear" and every widget would lose its role's curve. The alloc is
    # not guaranteed zeroed anyway; this is the explicit seed either way.
    store64(wgt + DH_W_MO_ROLE, RupaMotion.RU_MO_QUICK);
    store64(wgt + DH_W_MO_MS, 0);
    store64(wgt + DH_W_MO_EASE, 0 - 1);
    # ⛔ AND `DH_W_SEL` IS THE SAME TRAP AS THE EASE ABOVE: 0 is a VALID selection (the first child),
    # so a zeroed field would mean every list in the system boots with row 0 highlighted and a
    # `dh_list_selected` that lies about the operator having chosen anything. -1 is "nothing selected".
    store64(wgt + DH_W_SEL, 0 - 1);
    store64(wgt + DH_W_SCROLL_Y, 0);
    store64(wgt + DH_W_TEXT_CAP, 0);
    store64(wgt + DH_W_TEXT_LEN, 0);
    store64(wgt + DH_W_CARET, 0);
    store64(wgt + DH_W_DRAW, 0);
    store64(wgt + DH_W_FG, 0 - 1);         # inherit
    store64(wgt + DH_W_X, 0);
    store64(wgt + DH_W_Y, 0);
    store64(wgt + DH_W_W, 0);
    store64(wgt + DH_W_H, 0);
    store64(wgt + DH_W_PARENT, 0);
    store64(wgt + DH_W_FIRST_CHILD, 0);
    store64(wgt + DH_W_NEXT_SIBLING, 0);
    store64(wgt + DH_W_LAYOUT, 0);         # NONE
    store64(wgt + DH_W_BG, 0 - 1);         # -1 = no background
    store64(wgt + DH_W_TEXT, 0);
    store64(wgt + DH_W_PREF_W, 0);
    store64(wgt + DH_W_PREF_H, 0);
    store64(wgt + DH_W_HANDLER, 0);        # no bubble handler
    store64(wgt + DH_W_USERDATA, 0);
    store64(wgt + DH_W_CAPTURE_H, 0);      # no capture handler
    store64(wgt + DH_W_FLAGS, 0);          # no flags
    store64(wgt + DH_W_FLEX, 0);           # fixed (not flexible)
    store64(wgt + DH_W_PAD, 0);            # no padding
    store64(wgt + DH_W_GAP, 0);            # no gap
    store64(wgt + DH_W_ALIGN, 0);          # ALIGN_STRETCH
    store64(wgt + DH_W_FILL, 0 - 1);       # -1 = indeterminate (see the ⛔ at the field)
    store64(wgt + DH_W_OFF_X, 0);          # ⛔ seeded: arena memory is RECYCLED, not zero
    store64(wgt + DH_W_OFF_Y, 0);
    store64(wgt + DH_W_BORDER, DH_BORDER_INHERIT);
    # ⛔ SEEDED, LIKE EVERY FIELD ABOVE, BECAUSE ARENA MEMORY IS RECYCLED AND NOT ZERO. A widget that
    # inherited the previous frame's key at this address would be silently adopted as the focused or
    # dragged widget — the exact failure this field exists to prevent, caused by the field itself.
    store64(wgt + DH_W_KEY, 0);
    # ⛔ SEEDED, like every field above — arena memory is RECYCLED and not zero. A widget inheriting
    # the previous frame's cell size here would lay a grid out to a geometry nothing asked for.
    store64(wgt + DH_W_CELL_W, 0);
    store64(wgt + DH_W_CELL_H, 0);
    store64(wgt + DH_W_SCROLL_X, 0);      # ⛔ seeded: arena memory is RECYCLED, not zero
    return wgt;
}

# Append `child` as the last child of `parent`. Sets child.parent and
# links it onto the sibling chain. Returns DHANCHA_OK / an error code.
fn dh_widget_add_child(parent, child): i64 {
    if (parent == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (child == 0)  { return DHANCHA_ERR_BAD_WIDGET; }
    store64(child + DH_W_PARENT, parent);
    var head = load64(parent + DH_W_FIRST_CHILD);
    if (head == 0) {
        store64(parent + DH_W_FIRST_CHILD, child);
        return DHANCHA_OK;
    }
    # walk to the last sibling and append
    var cur = head;
    while (load64(cur + DH_W_NEXT_SIBLING) != 0) {
        cur = load64(cur + DH_W_NEXT_SIBLING);
    }
    store64(cur + DH_W_NEXT_SIBLING, child);
    return DHANCHA_OK;
}

# ---- accessors ----------------------------------------------------

fn dh_widget_id(wgt): i64          { return load64(wgt + DH_W_ID); }
fn dh_widget_kind(wgt): i64        { return load64(wgt + DH_W_KIND); }
fn dh_widget_x(wgt): i64           { return load64(wgt + DH_W_X); }
fn dh_widget_y(wgt): i64           { return load64(wgt + DH_W_Y); }
fn dh_widget_w(wgt): i64           { return load64(wgt + DH_W_W); }
fn dh_widget_h(wgt): i64           { return load64(wgt + DH_W_H); }
fn dh_widget_parent(wgt): i64      { return load64(wgt + DH_W_PARENT); }
fn dh_widget_first_child(wgt): i64 { return load64(wgt + DH_W_FIRST_CHILD); }
fn dh_widget_next_sibling(wgt): i64 { return load64(wgt + DH_W_NEXT_SIBLING); }

# Set the resolved bounds (called by the layout pass).
fn dh_widget_set_bounds(wgt, x, y, w, h): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_X, x);
    store64(wgt + DH_W_Y, y);
    store64(wgt + DH_W_W, w);
    store64(wgt + DH_W_H, h);
    return DHANCHA_OK;
}

# ---- style + layout properties ------------------------------------

fn dh_widget_layout(wgt): i64 { return load64(wgt + DH_W_LAYOUT); }
fn dh_widget_bg(wgt): i64     { return load64(wgt + DH_W_BG); }
fn dh_widget_text(wgt): i64   { return load64(wgt + DH_W_TEXT); }
fn dh_widget_pref_w(wgt): i64 { return load64(wgt + DH_W_PREF_W); }
fn dh_widget_pref_h(wgt): i64 { return load64(wgt + DH_W_PREF_H); }

# Set the child-layout mode (DhLayout: NONE / BOX_H / BOX_V / FLEX).
fn dh_widget_set_layout(wgt, mode): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_LAYOUT, mode);
    return DHANCHA_OK;
}

# Set the background color (0x00RRGGBB), or -1 for no background.
fn dh_widget_set_bg(wgt, color): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_BG, color);
    return DHANCHA_OK;
}

# Set the widget's text (a borrowed cstring pointer, or 0).
fn dh_widget_set_text(wgt, text): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_TEXT, text);
    return DHANCHA_OK;
}

# Set the preferred (requested) size, a layout hint.
fn dh_widget_set_pref(wgt, w, h): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_PREF_W, w);
    store64(wgt + DH_W_PREF_H, h);
    return DHANCHA_OK;
}

# ---- event handler + userdata -------------------------------------

fn dh_widget_handler(wgt): i64  { return load64(wgt + DH_W_HANDLER); }
fn dh_widget_userdata(wgt): i64 { return load64(wgt + DH_W_USERDATA); }

# Attach an event-handler function pointer. Take the address with
# `&fn_name` (the fn must be `handler(wgt, ev): i64` returning 1 to
# consume the event, 0 to let it bubble). Pass 0 to clear.
fn dh_widget_set_handler(wgt, fp): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_HANDLER, fp);
    return DHANCHA_OK;
}

# Attach opaque app context the handler can read back via
# dh_widget_userdata (dispatch passes only the widget + event).
fn dh_widget_set_userdata(wgt, ud): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_USERDATA, ud);
    return DHANCHA_OK;
}

# Can this widget take keyboard focus? BUTTON / TEXTINPUT do; structural
# nodes (WINDOW / BOX / LABEL) do not. Click-to-focus consults this.
fn dh_widget_focusable(wgt): i64 {
    if (wgt == 0) { return 0; }
    var k = dh_widget_kind(wgt);
    if (k == BUTTON)    { return 1; }
    if (k == TEXTINPUT) { return 1; }
    # ⭐ A LIST TAKES FOCUS (0.9.8). Arrow keys have to reach it, and Tab has to be able to land on
    # it — a scrollable list the keyboard cannot enter is a mouse-only control, which is the
    # accessibility failure that matches painted-but-inert on the input side.
    if (k == LIST)      { return 1; }
    return 0;
}

# ---- capture-phase handler ----------------------------------------

fn dh_widget_capture_handler(wgt): i64 { return load64(wgt + DH_W_CAPTURE_H); }

# Attach a capture-phase handler (fires root -> target, BEFORE the bubble
# handlers). Same `handler(wgt, ev): i64` shape; return 1 to consume the
# event (which also cancels the bubble pass). Pass 0 to clear.
fn dh_widget_set_capture_handler(wgt, fp): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_CAPTURE_H, fp);
    return DHANCHA_OK;
}

# ---- behavior flags (drag source / drop target) -------------------

fn dh_widget_flags(wgt): i64 { return load64(wgt + DH_W_FLAGS); }

# Set/clear one flag bit without touching the others.
fn dh_widget_set_flag(wgt, flag, on): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var f = load64(wgt + DH_W_FLAGS);
    if (on == 0) {
        f = f & (0 - 1 - flag);            # clear: AND with ~flag (two's complement)
    } else {
        f = f | flag;
    }
    store64(wgt + DH_W_FLAGS, f);
    return DHANCHA_OK;
}

# @public — place this child `dx, dy` px from its NONE container's padded content origin.
# ⚠ NONE CONTAINERS ONLY (see the ⛔ at `DH_W_OFF_X`). Set on a BOX child it is stored and ignored —
# deliberately: silently ignoring beats a half-honoured margin, and refusing would mean the setter
# had to know the parent, which a child may not have yet.
fn dh_widget_set_offset(wgt, dx, dy): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_OFF_X, dx);
    store64(wgt + DH_W_OFF_Y, dy);
    return DHANCHA_OK;
}

fn dh_widget_off_x(wgt): i64 { if (wgt == 0) { return 0; } return load64(wgt + DH_W_OFF_X); }
fn dh_widget_off_y(wgt): i64 { if (wgt == 0) { return 0; } return load64(wgt + DH_W_OFF_Y); }

# @public — border colour, `DH_BORDER_INHERIT`, or `DH_BORDER_NONE`.
fn dh_widget_set_border(wgt, col): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_BORDER, col);
    return DHANCHA_OK;
}

fn dh_widget_border(wgt): i64 {
    if (wgt == 0) { return DH_BORDER_INHERIT; }
    return load64(wgt + DH_W_BORDER);
}

# @public — is this widget inert (unselectable, unhittable as a row)? 1 = yes.
fn dh_widget_inert(wgt): i64 {
    if (wgt == 0) { return 0; }
    if ((load64(wgt + DH_W_FLAGS) & DH_FLAG_INERT) != 0) { return 1; }
    return 0;
}

fn dh_widget_set_inert(wgt, on): i64 { return dh_widget_set_flag(wgt, DH_FLAG_INERT, on); }
fn dh_widget_set_scrim(wgt, on): i64 { return dh_widget_set_flag(wgt, DH_FLAG_SCRIM, on); }

fn dh_widget_set_draggable(wgt, on): i64   { return dh_widget_set_flag(wgt, DH_FLAG_DRAGGABLE, on); }
fn dh_widget_set_drop_target(wgt, on): i64 { return dh_widget_set_flag(wgt, DH_FLAG_DROP_TARGET, on); }

fn dh_widget_is_draggable(wgt): i64 {
    if (wgt == 0) { return 0; }
    if ((dh_widget_flags(wgt) & DH_FLAG_DRAGGABLE) != 0) { return 1; }
    return 0;
}

fn dh_widget_is_drop_target(wgt): i64 {
    if (wgt == 0) { return 0; }
    if ((dh_widget_flags(wgt) & DH_FLAG_DROP_TARGET) != 0) { return 1; }
    return 0;
}

# ---- flex / box layout properties ---------------------------------

fn dh_widget_flex(wgt): i64    { return load64(wgt + DH_W_FLEX); }

# @public — this widget's own text colour, or -1 to inherit from its parent.
fn dh_widget_fg(wgt): i64 { if (wgt == 0) { return 0 - 1; } return load64(wgt + DH_W_FG); }

# @public — set this widget's text colour (and its subtree's, unless a child overrides). -1 inherits.
fn dh_widget_set_fg(wgt, col): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_FG, col);
    return 0;
}
fn dh_widget_padding(wgt): i64 { return load64(wgt + DH_W_PAD); }
fn dh_widget_gap(wgt): i64     { return load64(wgt + DH_W_GAP); }
fn dh_widget_align(wgt): i64   { return load64(wgt + DH_W_ALIGN); }

# Is screen point (px, py) inside this widget's box? The half-open convention (x <= p < x + w) is
# the same one `dh_hit_test` and the painter's clip use — three places agreeing that a widget owns
# its top-left edge and not its bottom-right is what stops a 1px seam between adjacent widgets
# from being either dead or claimed twice.
fn dh_widget_contains(wgt, px, py): i64 {
    if (wgt == 0) { return 0; }
    var x = load64(wgt + DH_W_X);
    var y = load64(wgt + DH_W_Y);
    if (px < x) { return 0; }
    if (py < y) { return 0; }
    if (px >= x + load64(wgt + DH_W_W)) { return 0; }
    if (py >= y + load64(wgt + DH_W_H)) { return 0; }
    return 1;
}

# ⚠ RAW STATE ACCESSORS — no clamping. A caller that wants "scroll, but not past the end" wants
# `dh_list_scroll_to` in list.cyr, which knows the content height. This pair exists because layout
# and draw need the stored number, and a clamping getter would make them depend on the policy layer.
fn dh_widget_scroll_y(wgt): i64 { if (wgt == 0) { return 0; } return load64(wgt + DH_W_SCROLL_Y); }
fn dh_widget_scroll_x(wgt): i64 { if (wgt == 0) { return 0; } return load64(wgt + DH_W_SCROLL_X); }
fn dh_widget_sel(wgt): i64      { if (wgt == 0) { return 0 - 1; } return load64(wgt + DH_W_SEL); }

# Flex weight: 0 = fixed (takes its pref main-axis size); > 0 = flexible
# (grows to share the container's leftover main-axis space by weight).
fn dh_widget_set_flex(wgt, weight): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_FLEX, weight);
    return DHANCHA_OK;
}

# Uniform padding inset applied to this container's content box.
fn dh_widget_set_padding(wgt, pad): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_PAD, pad);
    return DHANCHA_OK;
}

# Spacing inserted between consecutive children in BOX_H / BOX_V.
fn dh_widget_set_gap(wgt, gap): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_GAP, gap);
    return DHANCHA_OK;
}

# Cross-axis alignment of this child within its container (a DhAlign).
fn dh_widget_set_align(wgt, align): i64 {
    if (wgt == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(wgt + DH_W_ALIGN, align);
    return DHANCHA_OK;
}
