# @public — dhancha GRID: a wrapping, selectable grid of fixed-size cells.
# grid.cyr — the POLICY over the wrap arithmetic, the selection and the scroll that widget.cyr stores.
#
# ⭐ WHY THIS EXISTS AS A WIDGET. The same argument `list.cyr` makes, one dimension further: every
# file manager, launcher and picker in this stack wants "items in a wrapping flow, one of them
# highlighted, the whole thing scrolling" — and each would compute `cols = (w + gap) / (cell + gap)`
# for itself, get the last row's remainder wrong, and paint its own highlight.
#
# ⛔⛔ IT EARNS A KIND, AND THE BAR IS THIS REPO'S OWN. `progress.cyr` states it and 0.9.23 applied
# it by REFUSING one to MENU and SHEET: *a kind earns itself only when composing it would force the
# APP to name a theme colour, or when it expresses state no existing kind can hold.* A grid built
# from BOXes clears both — the app would paint the selected cell itself, which means naming
# `accent`, which crab's ADR 0001 forbids; and a wrapped flow is state (which cell, at which column,
# on which row) that no existing kind holds.
#
# ⛔ THIS FILE OWNS NO PIXELS AND NO STATE, exactly like `list.cyr`. The cell size lives on the
# widget (`DH_W_CELL_W` / `DH_W_CELL_H`), the selection on `DH_W_SEL`, the offset on
# `DH_W_SCROLL_Y`; `layout.cyr` places the children and `surface.cyr` clips and highlights them.
# What lives here is the arithmetic that keeps those numbers COHERENT — the part that is easy to get
# wrong and boring to get right.
#
# ⚠ FIXED-SIZE CELLS, DELIBERATELY. A grid of variable-size cells is a packing problem, and a
# packing problem has no correct keyboard navigation — "the cell below" stops being well defined.
# Every consumer this is written for shows uniform tiles.

# @public — a new GRID container. `cell_w` × `cell_h` is the size every cell gets; `gap` is the
# spacing between them, in both axes.
#
# ⚠ The layout mode is NONE: a grid places its children itself (see `dh_layout_grid`), and a BOX
# mode would have the flex distributor fight it for the same space.
fn dh_grid_new(cell_w, cell_h, gap): i64 {
    var w = dh_widget_new(DhWidgetKind.GRID);
    dh_widget_set_layout(w, DhLayout.NONE);
    var cw = cell_w;
    var ch = cell_h;
    # ⛔ A ZERO OR NEGATIVE CELL WOULD DIVIDE BY ZERO IN THE WRAP. Clamped here, at the one place a
    # cell size can be set, rather than defended at every reader.
    if (cw < 1) { cw = 1; }
    if (ch < 1) { ch = 1; }
    store64(w + DH_W_CELL_W, cw);
    store64(w + DH_W_CELL_H, ch);
    var g = gap;
    if (g < 0) { g = 0; }
    store64(w + DH_W_GAP, g);
    return w;
}

fn dh_grid_cell_w(g): i64 { if (g == 0) { return 0; } return load64(g + DH_W_CELL_W); }
fn dh_grid_cell_h(g): i64 { if (g == 0) { return 0; } return load64(g + DH_W_CELL_H); }

# @public — append `cell` as the next item. Pins its size and its flex, for the reason `dh_list_add`
# pins a row's: a flex child grows to share leftover space, and a grid of flex cells has content
# exactly as tall as its viewport and never scrolls.
fn dh_grid_add(g, cell): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (cell == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    store64(cell + DH_W_PREF_W, dh_grid_cell_w(g));
    store64(cell + DH_W_PREF_H, dh_grid_cell_h(g));
    store64(cell + DH_W_FLEX, 0);
    return dh_widget_add_child(g, cell);
}

# @public — how many cells this grid holds.
fn dh_grid_count(g): i64 {
    if (g == 0) { return 0; }
    var n = 0;
    var c = dh_widget_first_child(g);
    while (c != 0) {
        n = n + 1;
        c = dh_widget_next_sibling(c);
    }
    return n;
}

# @public — the cell at index `i`, or 0.
fn dh_grid_cell_at(g, i): i64 {
    if (g == 0) { return 0; }
    if (i < 0) { return 0; }
    var n = 0;
    var c = dh_widget_first_child(g);
    while (c != 0) {
        if (n == i) { return c; }
        n = n + 1;
        c = dh_widget_next_sibling(c);
    }
    return 0;
}

# @public — how many cells fit across a grid `avail_w` wide. Always at least 1.
#
# ⛔ THIS IS THE ARITHMETIC THE WIDGET EXISTS FOR, and the off-by-one is in the gap: `n` cells carry
# `n - 1` gaps, not `n`. Solving `n*cell + (n-1)*gap <= avail` gives `n = (avail + gap) / (cell +
# gap)` — the `+ gap` is what accounts for the gap the last cell does not have. Dropping it loses a
# column at exactly the widths where a column fits perfectly, which is the width a caller is most
# likely to have chosen on purpose.
# ⚠ NEVER ZERO. A grid narrower than one cell shows one cell clipped, which is visible and
# recoverable; zero columns is a division by zero in every reader below.
fn dh_grid_cols_for(g, avail_w): i64 {
    if (g == 0) { return 1; }
    var cw = dh_grid_cell_w(g);
    if (cw < 1) { return 1; }
    var gap = dh_widget_gap(g);
    var n = (avail_w + gap) / (cw + gap);
    if (n < 1) { n = 1; }
    return n;
}

# @public — the number of columns this grid was last LAID OUT with.
#
# ⛔ READ FROM THE LAYOUT, NOT RECOMPUTED FROM THE PREF. Navigation has to agree with what the
# operator can see: `dh_grid_move_sel` moving "down" by a different column count than the one on
# screen is the class of bug where the cursor jumps two rows and nobody can say why. The grid's
# resolved width is what layout actually used, so that is what this reads.
fn dh_grid_cols(g): i64 {
    if (g == 0) { return 1; }
    var pad = dh_widget_padding(g);
    return dh_grid_cols_for(g, dh_widget_w(g) - pad - pad);
}

# @public — total content height: every row of cells plus the gaps between them.
fn dh_grid_content_h(g): i64 {
    if (g == 0) { return 0; }
    var n = dh_grid_count(g);
    if (n < 1) { return 0; }
    var cols = dh_grid_cols(g);
    # ⚠ Ceiling division: 7 cells in 3 columns is 3 rows, not 2.
    var rows = (n + cols - 1) / cols;
    var ch = dh_grid_cell_h(g);
    var gap = dh_widget_gap(g);
    return rows * ch + (rows - 1) * gap;
}

# @public — the largest legal scroll offset. Never negative: content shorter than the viewport
# does not scroll at all.
fn dh_grid_max_scroll(g): i64 {
    if (g == 0) { return 0; }
    var pad = dh_widget_padding(g);
    var view = dh_widget_h(g) - pad - pad;
    var m = dh_grid_content_h(g) - view;
    if (m < 0) { m = 0; }
    return m;
}

# @public — set the scroll offset, clamped to [0, max].
fn dh_grid_scroll_to(g, y): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var v = y;
    if (v < 0) { v = 0; }
    var m = dh_grid_max_scroll(g);
    if (v > m) { v = m; }
    store64(g + DH_W_SCROLL_Y, v);
    return DHANCHA_OK;
}

fn dh_grid_scroll_by(g, dy): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    return dh_grid_scroll_to(g, load64(g + DH_W_SCROLL_Y) + dy);
}

# @public — the selected cell index, or -1.
fn dh_grid_selected(g): i64 {
    if (g == 0) { return 0 - 1; }
    return load64(g + DH_W_SEL);
}

# @public — select cell `i`. Out of range is refused rather than clamped: a caller that computed a
# bad index wants to know, and silently landing on the last cell hides it.
# ⚠ `DH_FLAG_INERT` cells are refused, exactly as `dh_list_select` refuses an inert row — a grid can
# carry a placeholder for a file it could not read, and selecting one means acting on nothing.
fn dh_grid_select(g, i): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (i < 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (i >= dh_grid_count(g)) { return DHANCHA_ERR_BAD_WIDGET; }
    var c = dh_grid_cell_at(g, i);
    if (c != 0) {
        if ((dh_widget_flags(c) & DH_FLAG_INERT) != 0) { return DHANCHA_ERR_BAD_WIDGET; }
    }
    store64(g + DH_W_SEL, i);
    return DHANCHA_OK;
}

# @public — move the selection by `dx` columns and `dy` rows. -> DHANCHA_OK if it moved.
#
# ⛔⛔ A GRID'S ARROW KEYS ARE NOT A LIST'S, AND THIS IS THE WHOLE REASON THE KIND EXISTS. Left and
# right step by one; up and down step by a WHOLE ROW. An app driving a grid with `dh_list_move_sel`
# gets a cursor that walks the flow one cell at a time and appears to move diagonally.
#
# ⛔ HORIZONTAL MOVEMENT DOES NOT WRAP TO THE NEXT ROW. Right at the end of a row stays put. The
# grid is a 2-D arrangement the operator can see, so the cursor must move the way the arrow points —
# wrapping makes "right" mean "down and all the way left", which is not what was pressed. ⚠ The
# context MENU wraps and is right to: six items visible at once, where running off the end and
# continuing is faster than stopping. A grid of a thousand files is the opposite case.
# ⚠ Vertical movement past the last row is REFUSED rather than clamped to the final cell, for the
# same reason: down from the second-to-last row lands nowhere if that column has no cell below it,
# and jumping sideways to the last one is a move nobody asked for.
fn dh_grid_move_sel(g, dx, dy): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var n = dh_grid_count(g);
    if (n < 1) { return DHANCHA_ERR_BAD_WIDGET; }
    var cols = dh_grid_cols(g);
    var cur = dh_grid_selected(g);
    # An unset selection lands on the first cell, whichever direction was pressed — the operator
    # asked to start navigating and the answer is "here".
    if (cur < 0) { return dh_grid_step(g, 0, 1); }
    var col = cur - (cur / cols) * cols;
    var row = cur / cols;
    var ncol = col + dx;
    var nrow = row + dy;
    if (ncol < 0) { return DHANCHA_ERR_BAD_WIDGET; }
    if (ncol >= cols) { return DHANCHA_ERR_BAD_WIDGET; }
    if (nrow < 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var t = nrow * cols + ncol;
    if (t >= n) { return DHANCHA_ERR_BAD_WIDGET; }
    # ⚠ Step over an inert cell in the direction of travel, as a list does — a placeholder must not
    # trap the cursor.
    var dir = 1;
    if (dx < 0) { dir = 0 - 1; }
    if (dy < 0) { dir = 0 - 1; }
    return dh_grid_step(g, t, dir);
}

# Select `from`, or the next selectable cell in direction `dir` (+1 / -1). -> DHANCHA_OK if one was
# found. ⚠ Bounded by the cell count, so a grid of entirely inert cells terminates rather than
# spinning — the same guard `dh_list_move_sel` carries.
fn dh_grid_step(g, from, dir): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var n = dh_grid_count(g);
    var i = from;
    var tries = 0;
    while (tries < n) {
        if (i >= 0) {
            if (i < n) {
                if (dh_grid_select(g, i) == DHANCHA_OK) { return DHANCHA_OK; }
            }
        }
        i = i + dir;
        tries = tries + 1;
    }
    return DHANCHA_ERR_BAD_WIDGET;
}

# @public — scroll the minimum distance that brings the selected cell fully into view.
#
# ⚠ MINIMUM MOVE, like `dh_list_scroll_to_sel`: a selection already visible does not scroll at all,
# and one just off an edge moves by exactly the shortfall. Snapping the selection to the top on
# every step is the behaviour that makes a grid feel like it is fighting the operator.
fn dh_grid_scroll_to_sel(g): i64 {
    if (g == 0) { return DHANCHA_ERR_BAD_WIDGET; }
    var sel = dh_grid_selected(g);
    if (sel < 0) { return DHANCHA_OK; }
    var cols = dh_grid_cols(g);
    var row = sel / cols;
    var ch = dh_grid_cell_h(g);
    var gap = dh_widget_gap(g);
    var top = row * (ch + gap);
    var bot = top + ch;
    var off = load64(g + DH_W_SCROLL_Y);
    var pad = dh_widget_padding(g);
    var view = dh_widget_h(g) - pad - pad;
    if (top < off) { return dh_grid_scroll_to(g, top); }
    if (bot > off + view) { return dh_grid_scroll_to(g, bot - view); }
    return DHANCHA_OK;
}

# @public — which cell contains point (px, py) in SURFACE coordinates? -> index, or -1.
#
# ⛔ FROM THE LAID-OUT CELLS, NOT FROM THE ARITHMETIC. Recomputing row and column from the pointer
# would be a second answer to "where is cell i", free to disagree with the one layout produced —
# and it is the disagreement, not either answer, that makes a click land on the wrong file. The gaps
# BETWEEN cells belong to no cell, and walking the children is what gets that right for free.
# ⚠ An inert cell reports -1, matching `dh_list_index_at`: a placeholder the keyboard steps over
# must not be clickable either.
fn dh_grid_index_at(g, px, py): i64 {
    if (g == 0) { return 0 - 1; }
    var i = 0;
    var c = dh_widget_first_child(g);
    while (c != 0) {
        var cx = dh_widget_x(c);
        var cy = dh_widget_y(c);
        if (px >= cx) {
            if (px < cx + dh_widget_w(c)) {
                if (py >= cy) {
                    if (py < cy + dh_widget_h(c)) {
                        if ((dh_widget_flags(c) & DH_FLAG_INERT) != 0) { return 0 - 1; }
                        return i;
                    }
                }
            }
        }
        i = i + 1;
        c = dh_widget_next_sibling(c);
    }
    return 0 - 1;
}
