# @public — dhancha client surface / present path.
# surface.cyr — DhSurface: a client window backed by a pixel buffer.
#
# A DhSurface is the app's window from the client's side: a CPU pixel
# buffer the toolkit draws the widget tree into, then presents to the
# aethersafha compositor as a client surface over the native protocol (which the
# compositor composites onto the screen). v0.1.0 allocates the buffer;
# the draw + present code lands in v0.2 once sadish / rekha / mabda are
# wired.
#
# DhSurface struct layout (48 bytes):
#   +0:  width   — surface width in pixels
#   +8:  height  — surface height in pixels
#   +16: pixels  — owned RGBA8 buffer (width*height*4 bytes), or 0 until first ASKED for
#   +24: root    — the DhWidget tree root drawn into this surface (or 0)
#   +32: dirty   — 1 if the buffer needs a redraw before next present
#   +40: sds     — the cached sadish render target `dh_surface_render` draws into, or 0 until the
#                  first render. ⚠ 0.9.14 — the struct was 40 bytes before this field.
enum DhSurfaceField {
    DH_S_WIDTH  = 0;
    DH_S_HEIGHT = 8;
    DH_S_PIXELS = 16;
    DH_S_ROOT   = 24;
    DH_S_DIRTY  = 32;
    DH_S_SDS    = 40;
}

# Allocate a DhSurface. Returns a DhSurface* (or 0 on OOM — the caller
# can map that to DHANCHA_ERR_NO_SURFACE / _OOM).
#
# ⛔⛔ THE `w*h*4` PIXEL BUFFER IS NO LONGER ALLOCATED HERE (0.9.13), BECAUSE IT WAS ALLOCATED ALWAYS
# AND USED NEVER. `dh_surface_render` — the only function in this file that draws — ignores
# `DH_S_PIXELS` entirely and allocates its own `sd_surface_new(w, h)` to draw into. So every surface
# carried a full-size buffer that nothing ever wrote and nothing ever read.
# ⚠ AND THE ALLOCATOR UNDERNEATH HAS NO `free()`. `lib/alloc.cyr` is a bump allocator; `alloc_reset`
# rewinds the WHOLE arena, so a consumer that builds a surface per frame cannot reclaim any of it.
# MEASURED against crab 0.5.0 at 380x220 with 114 entries per pane: `crab_render` cost 746,440 B per
# frame, of which **334,440 B was this buffer** — 45 % of a per-keypress leak, for a buffer with no
# reader. At a 60 Hz repaint that alone is 20 MB/s.
# ⇒ The field is kept and the ALLOCATION IS DEFERRED to `dh_surface_pixels`, rather than deleted.
# `surface.cyr` is in the published dist bundle, so an external caller may hold the accessor; deferring
# keeps that caller's contract byte-for-byte (it still gets an owned w*h*4 buffer) while every caller
# that does not ask — which is all of dhancha, all of its programs, puka and crab — pays nothing.
# ⚠ THIS IS NOT THE ONE-LINE CHANGE IT LOOKS LIKE. Simply storing 0 breaks `programs/event_test.cyr`
# S): `dh_surface_present` refuses with `_NO_SURFACE` when pixels are 0 and `_UNSUPPORTED` otherwise,
# so a permanently-zero field silently converts dhancha's "refuse loudly and diagnosably" contract
# into "bad surface". Deferring preserves it: the refusal path asks for pixels, gets a real buffer,
# and still returns `_UNSUPPORTED`.
fn dh_surface_new(w, h): i64 {
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    var surf = alloc(48);
    store64(surf + DH_S_WIDTH, w);
    store64(surf + DH_S_HEIGHT, h);
    store64(surf + DH_S_PIXELS, 0);
    store64(surf + DH_S_ROOT, 0);
    store64(surf + DH_S_DIRTY, 1);
    store64(surf + DH_S_SDS, 0);
    return surf;
}

fn dh_surface_width(surf): i64  { return load64(surf + DH_S_WIDTH); }
fn dh_surface_height(surf): i64 { return load64(surf + DH_S_HEIGHT); }

# The surface's own RGBA8 buffer, allocated on the FIRST call and cached thereafter (0.9.13 — see
# the ⛔ on `dh_surface_new`). Returns 0 only for a null surface or a degenerate size.
# ⚠ IT IS STILL NOT WHAT `dh_surface_render` DRAWS INTO, and it never was — that has always been a
# separate `sd_surface_new`. This accessor hands back the same never-written buffer it always did;
# what changed is that a caller who does not ask no longer pays for it.
fn dh_surface_pixels(surf): i64 {
    if (surf == 0) { return 0; }
    var buf = load64(surf + DH_S_PIXELS);
    if (buf != 0) { return buf; }
    var w = load64(surf + DH_S_WIDTH);
    var h = load64(surf + DH_S_HEIGHT);
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    buf = alloc(w * h * 4);
    store64(surf + DH_S_PIXELS, buf);
    return buf;
}

fn dh_surface_root(surf): i64   { return load64(surf + DH_S_ROOT); }

# @public — resize a live surface to `w` x `h` (0.9.17). -> DHANCHA_OK, or `_NO_SURFACE` / `_BAD_ARG`.
#
# ⭐⭐ THIS IS THE ENTRY POINT `WINDOW_CONFIGURE` HAS BEEN WAITING FOR SINCE 0.9.12. The compositor has
# been able to ASK a client to resize for five releases, and no client could act on it: a `DhSurface`'s
# `w`/`h` were fixed at construction and there was no way to change them. A client that ignores the ask
# does not crash — it FREEZES at its old extent while the compositor clamps or refuses every blit.
#
# ⛔⛔ AND IT CLOSES A LATENT BUFFER OVERFLOW THAT 0.9.13 CREATED AND NOTHING COULD REACH UNTIL NOW.
# `dh_surface_pixels` allocates `w*h*4` **on first ask** and caches it. With `w`/`h` immutable that was
# safe by construction. The moment a surface can grow, a cached buffer sized for the OLD extent is
# handed to a caller that will write the NEW one — a silent heap overflow, in a bump allocator where
# the bytes past it are other live objects. ⇒ **The pixel cache MUST be dropped here**, and it is. The
# next `dh_surface_pixels` re-allocates at the new size.
# ⚠ The old buffer is abandoned, not freed — there is nothing to free it with. A resize therefore costs
# one screenful, once, which is the right trade against handing back a short one.
#
# ⭐ THE RENDER TARGET IS **NOT** DROPPED HERE, DELIBERATELY. `dh_surface_render` already compares the
# cached target's dimensions against the surface's and re-allocates on a mismatch. That branch was
# written in 0.9.14, documented as unreachable, and measured as such — deleting it did not fail
# `draw_test`. **This function is what makes it live**, which is exactly what its ⚠ said would happen,
# so the check stays the mechanism rather than being duplicated into a second place that can drift.
fn dh_surface_resize(surf, w, h): i64 {
    if (surf == 0) { return DHANCHA_ERR_NO_SURFACE; }
    if (w <= 0) { return DHANCHA_ERR_BAD_ARG; }
    if (h <= 0) { return DHANCHA_ERR_BAD_ARG; }
    if (load64(surf + DH_S_WIDTH) == w) {
        if (load64(surf + DH_S_HEIGHT) == h) { return DHANCHA_OK; }   # no-op: same extent
    }
    store64(surf + DH_S_WIDTH, w);
    store64(surf + DH_S_HEIGHT, h);
    store64(surf + DH_S_PIXELS, 0);        # ⛔ see above — a stale-sized cache is an overflow
    store64(surf + DH_S_DIRTY, 1);
    return DHANCHA_OK;
}

# Attach the widget-tree root that this surface renders.
fn dh_surface_set_root(surf, root): i64 {
    if (surf == 0) { return DHANCHA_ERR_NO_SURFACE; }
    store64(surf + DH_S_ROOT, root);
    store64(surf + DH_S_DIRTY, 1);
    # ⭐⭐ RE-BIND THE RETAINED INPUT STATE (0.9.24). This is the one moment in a frame when the new
    # tree exists and the pointers `dh_frame_begin` dropped are known to be dead — so it is where
    # keyed focus, hover, press and drag come back to life. See `dh_rebind_input`.
    # ⛔ HERE RATHER THAN IN THE APP, for the same reason `crab_render` owns its arena: a step the
    # caller must remember is a step that gets forgotten, and forgetting this one restores exactly
    # the bug the keys exist to fix — silently, with a green suite.
    # ⚠ NO-OP FOR AN APP THAT KEYS NOTHING. Every shadow is 0, every branch is skipped, and the
    # function returns having touched nothing.
    dh_rebind_input(root);
    return DHANCHA_OK;
}

# ⛔⛔ THIS FUNCTION CANNOT PRESENT, AND UNTIL 0.9.5 IT CLAIMED IT HAD.
# It validated the surface, cleared the dirty flag and returned **DHANCHA_OK** — announcing success
# while sending nothing to the compositor. An app that reached for the obviously-named entry point got
# a silent no-op and a blank window, with a success code to explain it away. Nothing in this repo calls
# it, including dhancha's own programs, which is why the lie survived: it was never exercised.
#
# ⭐ THE REASON IT CANNOT WORK IS STRUCTURAL, NOT MISSING CODE. Presenting needs a CONNECTION, and this
# signature takes only a surface — there is no client, no fd, nowhere to send. The real entry point is
# `dh_client_present(c, surf, font)` in `dh_client.cyr`, which renders via `dh_surface_render` and hands
# the pixels to `setu_client_present`. That has existed since the client layer landed.
#
# ⇒ REFUSE, LOUDLY AND DIAGNOSABLY, rather than delete. `surface.cyr` is in the published dist bundle,
# so an external caller may exist; today it gets silence, and after this it gets an error code it can
# act on. ⚠ `DHANCHA_ERR_UNSUPPORTED` is the honest one — the operation is not supported *at this entry
# point*, as opposed to a bad surface (`_NO_SURFACE`) or a transient failure.
# ⚠ AND IT NO LONGER CLEARS THE DIRTY FLAG. Clearing it said "this surface has been shown", which was
# false, and would make a later real present skip a surface that had never reached the screen.
fn dh_surface_present(surf): i64 {
    if (surf == 0) { return DHANCHA_ERR_NO_SURFACE; }
    if (dh_surface_pixels(surf) == 0) { return DHANCHA_ERR_NO_SURFACE; }
    return DHANCHA_ERR_UNSUPPORTED;
}

# ---- widget-tree draw (sadish fills/strokes + rekha text) ----------

# ============================================================================================
# ⭐⭐ CLIPPING (0.9.7) — the draw side of a bound the INPUT side has always enforced
# ============================================================================================
# ⛔ THE DISAGREEMENT THIS CLOSES: `dh_hit_test` rejects a point outside a widget's rect at EVERY
# level of the recursion, so a child painted outside its parent was already un-clickable. Draw did
# not clip, so it was still VISIBLE. That combination — pixels you can see, that do not respond —
# is the single failure mode this stack keeps producing, and it is worse than either half alone,
# because it looks like a working control. Clipping the painter makes the two agree: if you can see
# it, you can hit it.
# ⚠ Applied to EVERY container, not just LIST. A special case for the scrolling kind would leave
# the same disagreement in place everywhere else, which is how it got here.

# Fill (x,y,w,h) intersected with the clip box (clx,cly,clw,clh). Exact — an axis-aligned rect
# clipped by an axis-aligned rect is another rect, so there is nothing to approximate.
fn dh_fill_rect_clip(sds, x, y, w, h, color, clx, cly, clw, clh): i64 {
    var x0 = x;
    var y0 = y;
    var x1 = x + w;
    var y1 = y + h;
    if (x0 < clx) { x0 = clx; }
    if (y0 < cly) { y0 = cly; }
    if (x1 > clx + clw) { x1 = clx + clw; }
    if (y1 > cly + clh) { y1 = cly + clh; }
    if (x1 <= x0) { return 0; }
    if (y1 <= y0) { return 0; }
    return sd_fill_rect(sds, x0, y0, x1 - x0, y1 - y0, color);
}

# A 1px border as four clipped edge fills. ⚠ NOT `sd_rect`, which draws through the clip: a
# half-scrolled row would otherwise stamp its bottom edge across whatever sits below the viewport.
fn dh_rect_clip(sds, x, y, w, h, color, clx, cly, clw, clh): i64 {
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    dh_fill_rect_clip(sds, x, y, w, 1, color, clx, cly, clw, clh);
    dh_fill_rect_clip(sds, x, y + h - 1, w, 1, color, clx, cly, clw, clh);
    dh_fill_rect_clip(sds, x, y, 1, h, color, clx, cly, clw, clh);
    dh_fill_rect_clip(sds, x + w - 1, y, 1, h, color, clx, cly, clw, clh);
    return 0;
}

# Draw `text` (a cstring) left-aligned inside a box at (x, y) of height h, onto
# the sadish surface `sds`, using `font` (a RekhaFont). Each glyph is converted
# to a sadish path (scaled so the em-height ~= h) and union-filled into one
# coverage canvas, then blit in `ink`. Advance is a fixed ~0.6em (real hmtx
# advances are a rekha v0.4 item). No-op if font is 0.
#
# ⚠ THE PUBLIC SIGNATURE IS UNCHANGED — it defaults to the theme's primary ink. `dh_draw_text_ink`
# is the variant that takes a colour, because the selected row needs a DIFFERENT one (0.9.20).
fn dh_draw_text(sds, font, text, x, y, h, clx, cly, clw, clh): i64 {
    return dh_draw_text_ink(sds, font, text, x, y, h, clx, cly, clw, clh, dh_theme_ink());
}

fn dh_draw_text_ink(sds, font, text, x, y, h, clx, cly, clw, clh, ink): i64 {
    if (text == 0) { return 0; }
    if (font == 0) {
        # Bitmap path: blit the kashi VGA 8x16 SYSTEM font (full CP437, crisp +
        # monospace, matching the compositor chrome) directly into the sadish
        # surface. rekha (font != 0) stays for scalable TrueType when a .ttf loads.
        kashi_font_init();
        var sw = sd_surface_width(sds);
        var sstride = sd_surface_stride(sds) / 4;   # see canvas.cyr: width != stride when wrapped
        var sh2 = sd_surface_height(sds);
        var pix = sd_surface_pixels(sds);
        # ⚠ `ink` is the PARAMETER now, not `dh_theme_ink()` — that is what lets the selected row
        # draw its label in on-accent instead of vanishing into the highlight.
        # The per-pixel bound is the SURFACE intersected with the CLIP. Folding them together here
        # means the inner loop keeps its original four comparisons — clipping costs nothing per pixel.
        var bx0 = clx; if (bx0 < 0) { bx0 = 0; }
        var by0 = cly; if (by0 < 0) { by0 = 0; }
        var bx1 = clx + clw; if (bx1 > sw) { bx1 = sw; }
        var by1 = cly + clh; if (by1 > sh2) { by1 = sh2; }
        var ky = y + (h - 16) / 2;             # vertically centre the 16px glyph in the box
        var kx = x + 3;
        var ki = 0;
        while (load8(text + ki) != 0) {
            var kc = load8(text + ki);
            var kr = 0;
            while (kr < 16) {
                var kb = kashi_glyph_row(0, kc, kr);   # KASHI_FONT_VGA_8X16 = 0; one row byte
                var kcol = 0;
                while (kcol < 8) {
                    if ((kb & (1 << (7 - kcol))) != 0) {
                        var px = kx + kcol; var py = ky + kr;
                        if (px >= bx0) { if (px < bx1) { if (py >= by0) { if (py < by1) {
                                        # ⚠ 0xFF000000 IS LOAD-BEARING (v0.9.2). `ink` is a rupa theme
                                        # token, 0x00RRGGBB — alpha byte ZERO. Every other painter in the
                                        # stack writes byte 3 = 255, so this one path produced glyph pixels
                                        # that were transparent-by-accident. Harmless while nothing read
                                        # byte 3; under agnos's gpu_shader_op#92 op 0x01 (premultiplied
                                        # src-over, which DOES read it) the shader is
                                        # `out = src + dst*(1 - src_a)`, so alpha 0 gives `out = src + dst`
                                        # — system-font text would render as an additive over-bright
                                        # ghost, not vanish, which is harder to notice, not easier.
                                        store32(pix + (py * sstride + px) * 4, ink | 0xFF000000);
                                    } } } }
                    }
                    kcol = kcol + 1;
                }
                kr = kr + 1;
            }
            kx = kx + 9;                        # 8px glyph + 1px gap (monospace)
            ki = ki + 1;
        }
        return 0;
    }
    var upem = rekha_units_per_em(font);
    if (upem <= 0) { return 0; }
    var scale = (h << 16) / upem;          # 16.16 pixels per design unit
    var advf = (h * 6) / 10;               # fixed advance ~0.6 em
    if (advf <= 0) { advf = 4; }
    var baseline = y + h - 2;              # sit text near the box bottom
    var cx = x + 2;

    var cv = sd_canvas_new(sd_surface_width(sds), sd_surface_height(sds));
    # ⭐ REAL per-pixel clipping for the scalable path — sadish's clip stack (v0.4.0) multiplies the
    # clip mask into the coverage before the blit, so a glyph straddling the viewport edge is CUT,
    # not dropped. Dropping the whole glyph was the tempting shortcut and it reads as text that
    # vanishes a row early while scrolling.
    sd_canvas_clip_push_rect(cv, clx, cly, clx + clw, cly + clh);
    var i = 0;
    while (load8(text + i) != 0) {
        var cp = load8(text + i);
        if (cp != 32) {                    # spaces contribute no coverage
            var path = rekha_char_to_sdpath(font, cp, scale, cx << 16, baseline << 16);
            sd_canvas_fill_union(cv, path, SD_FILL_NONZERO);
        }
        cx = cx + advf;
        i = i + 1;
    }
    # ⛔ THIS WAS HARDCODED `sd_rgb(255, 255, 255)` AND IGNORED THE THEME ENTIRELY (fixed 0.9.20).
    # White glyphs on MUDRA light's 0xFBF8F0 paper is white-on-white — the scalable-font path was
    # unreadable on both light grounds, and had been since it was written. The bitmap path (what
    # everything actually ships with, `font == 0`) always honoured the theme, which is why nothing
    # caught it.
    sd_canvas_blit(cv, sds, ink);
    sd_canvas_clip_pop(cv);
    return 0;
}

# Draw one widget (background, border, text) onto `sds`, then recurse into its
# children. `font` may be 0 (text skipped).
#
# ⚠ THE PUBLIC SIGNATURE IS UNCHANGED. puka calls this directly (`puka/src/ui.cyr`), as do dhancha's
# own test programs, so the ink travels in `dh_draw_widget_ink` rather than as a 8th parameter here.
fn dh_draw_widget(sds, wgt, font, clx, cly, clw, clh): i64 {
    return dh_draw_widget_ink(sds, wgt, font, clx, cly, clw, clh, dh_theme_ink(), 0);
}

# `ink` is the text colour for this widget AND everything below it, so a row handed on-accent passes
# it to its own labels — a row is not always a leaf.
# `forced` = 1 when the ink is a legibility GUARANTEE the subtree may not override (the selected
# row's on-accent). A widget's own `DH_W_FG` is a preference and yields to it.
fn dh_draw_widget_ink(sds, wgt, font, clx, cly, clw, clh, ink, forced): i64 {
    if (forced == 0) {
        var ownfg = dh_widget_fg(wgt);
        if (ownfg != (0 - 1)) { ink = ownfg; }
    }
    var x = dh_widget_x(wgt);
    var y = dh_widget_y(wgt);
    var w = dh_widget_w(wgt);
    var h = dh_widget_h(wgt);
    # ⛔ CULL FIRST. A subtree with no visible pixels must not paint OR recurse — in a 10 000-row list
    # scrolled to the bottom, the rows above are not "clipped away cheaply", they are never visited.
    # That is what makes a long list cost the viewport rather than the content.
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    if (x >= clx + clw) { return 0; }
    if (y >= cly + clh) { return 0; }
    if (x + w <= clx) { return 0; }
    if (y + h <= cly) { return 0; }

    var bg = dh_widget_bg(wgt);
    if (bg != (0 - 1)) {
        dh_fill_rect_clip(sds, x, y, w, h, bg, clx, cly, clw, clh);
    }
    # ⭐ A BORDER ON ANY WIDGET (0.9.23). Until now `dh_rect_clip` had exactly ONE call site in the
    # whole repo and it was hardcoded to BUTTON and to `dh_theme_line()`. A menu panel and a sheet
    # are both defined visually by their EDGE — and with no translucency available for a backdrop
    # (see `dh_draw_scrim`), the border is doing all the work of saying *this is a layer, not part of
    # the page*.
    # ⛔ RESOLVED HERE, AT DRAW TIME, NEVER STORED AT CONSTRUCTION. A widget that captured
    # `dh_theme_line()` when it was built would keep the old colour across a theme switch.
    var bcol = dh_widget_border(wgt);
    if (bcol == DH_BORDER_INHERIT) {
        bcol = DH_BORDER_NONE;
        if (dh_widget_kind(wgt) == BUTTON) { bcol = dh_theme_line(); }
    }
    if (bcol != DH_BORDER_NONE) {
        dh_rect_clip(sds, x, y, w, h, bcol, clx, cly, clw, clh);
    }
    # ⚠ AFTER the border and BEFORE the children, so a sheet's backdrop dims what is under it without
    # dimming the sheet itself — the sheet is a SIBLING in the layer, not a child of the scrim.
    if ((dh_widget_flags(wgt) & DH_FLAG_SCRIM) != 0) {
        dh_draw_scrim(sds, x, y, w, h, clx, cly, clw, clh);
    }
    # ⚠ BEFORE the text below, so a text set on a bar lands ON TOP of it rather than under it — the
    # same ordering reason the CANVAS arm sits before its children.
    if (dh_widget_kind(wgt) == PROGRESS) {
        dh_draw_progress(sds, wgt, x, y, w, h, clx, cly, clw, clh);
    }
    var text = dh_widget_text(wgt);
    if (text != 0) {
        dh_draw_text_ink(sds, font, text, x, y, h, clx, cly, clw, clh, ink);
    }
    # ⭐ THE CARET (0.9.7). Drawn only on the FOCUSED field: a caret in every text box at once says
    # every box is taking input, which is exactly the thing the operator uses it to find out.
    # ⚠ Positioned with the bitmap font's 9px advance — correct for the system font (which is what
    # `font == 0` draws with, and is monospace) and an approximation under rekha, where glyph
    # advances vary. A caret that drifts from proportional text is a rekha-advance item, not a
    # reason to withhold the caret from the monospace path that is what everything ships with.
    if (dh_widget_kind(wgt) == TEXTINPUT) {
        if (dh_focus_get() == wgt) {
            var cbytes = dh_text_caret(wgt);
            var cchars = dh_text_char_index(wgt, cbytes);
            var cx2 = x + 3 + (cchars * 9);
            var cy2 = y + (h - 16) / 2;
            dh_fill_rect_clip(sds, cx2, cy2, 1, 16, dh_theme_ink(), clx, cly, clw, clh);
        }
    }

    # ⭐ THE CHILD CLIP IS THIS NODE'S BOX INTERSECTED WITH THE INHERITED ONE. Intersecting (rather
    # than replacing) is what makes clipping compose through nesting: a row inside a list inside a
    # scrolled panel is bounded by all three, and no level can widen what an ancestor narrowed.
    var kx0 = x; var ky0 = y;
    var kx1 = x + w; var ky1 = y + h;
    if (kx0 < clx) { kx0 = clx; }
    if (ky0 < cly) { ky0 = cly; }
    if (kx1 > clx + clw) { kx1 = clx + clw; }
    if (ky1 > cly + clh) { ky1 = cly + clh; }
    if (kx1 <= kx0) { return 0; }
    if (ky1 <= ky0) { return 0; }

    # ⭐ CANVAS (0.9.9) — hand the rectangle to the app. Placed after this widget's own background
    # and BEFORE its children, so a canvas can be used as a backdrop with widgets composed on top;
    # it is given the CHILD clip, which is its own box intersected with everything above it.
    if (dh_widget_kind(wgt) == CANVAS) {
        var dfn = dh_canvas_draw_fn(wgt);
        if (dfn != 0) { fncall6(dfn, wgt, sds, kx0, ky0, kx1 - kx0, ky1 - ky0); }
    }

    # ⚠ BEFORE the rows, so a row's own background (if it has one) paints OVER the highlight rather
    # than the highlight hiding the row. A row that wants to stay visible when selected simply keeps
    # its background; the default — no background — lets the highlight through, which is what an app
    # that has stopped hand-rolling its selection expects.
    if (dh_widget_kind(wgt) == LIST) {
        dh_draw_list_selection(sds, wgt, kx0, ky0, kx1 - kx0, ky1 - ky0);
    }
    # ⭐ GRID (0.9.25) — the selected CELL's highlight, painted here for the same reason a LIST's is:
    # so the app never names `accent`. That is the whole reason GRID is a kind (ADR 0001 in crab).
    if (dh_widget_kind(wgt) == GRID) {
        dh_draw_grid_selection(sds, wgt, kx0, ky0, kx1 - kx0, ky1 - ky0);
    }

    # ⭐⭐ THE SELECTED ROW'S TEXT MUST SURVIVE ITS OWN HIGHLIGHT (0.9.20, rupa 0.1.5).
    # ⛔ THE HIGHLIGHT WAS ERASING THE ROW IT HIGHLIGHTED. `dh_draw_list_selection` above fills the
    # focused selection with `accent`, and every child was then drawn in the theme's primary `ink` —
    # on MUDRA dark, 0xE7E9EF on 0x00E5FF is a contrast ratio of **1.27:1**. The one row the operator
    # is looking at was the one row that could not be read.
    # ⚠ ONLY THE ACCENT FILL NEEDS THIS. An unfocused list fills its selection with `line` instead,
    # and normal ink reads fine on `line` in all four grounds — so the swap is gated on focus exactly
    # as the fill is, and the two cannot drift apart.
    var selrow = 0;
    if (dh_widget_kind(wgt) == LIST) {
        if (dh_focus_within(wgt) == 1) {
            var ssel = dh_widget_sel(wgt);
            if (ssel >= 0) { selrow = dh_list_row_at(wgt, ssel); }
        }
    }
    var child = dh_widget_first_child(wgt);
    while (child != 0) {
        var cink = ink;
        # ⚠ Compared by WIDGET POINTER, not by index — `dh_list_row_at` already answers which widget
        # is the selected row, and counting children again would be a second source of truth.
        var cforced = forced;
        if (selrow != 0) { if (child == selrow) { cink = dh_theme_on_accent(); cforced = 1; } }
        dh_draw_widget_ink(sds, child, font, kx0, ky0, kx1 - kx0, ky1 - ky0, cink, cforced);
        child = dh_widget_next_sibling(child);
    }
    return 0;
}

# ⭐⭐ THE SELECTION HIGHLIGHT (0.9.8) — drawn by the TOOLKIT, not by each app.
# ⛔ WHY THIS MOVED HERE. 0.9.7 stored `DH_W_SEL` and used it for scrolling, but nothing painted it,
# so a consumer adopting LIST still had to set a background on the selected row itself — which is
# exactly the hand-rolling the container was supposed to end. crab was the consumer that proved it:
# porting its panes onto LIST deleted the truncation and the scroll arithmetic and left its
# `if (selected) { bg = accent }` block untouched. A container that owns the selection must own how
# the selection LOOKS, or it has only taken half the job.
# ⚠ ACCENT WHEN FOCUSED, MUTED OTHERWISE. Two panes both showing an accented row is a display that
# cannot answer "which one do my arrow keys drive" — the single question a two-pane file manager
# exists to make obvious. This is the rule crab, puka and the launcher had each written separately.
# ⭐⭐ THE BAR (0.9.22) — two rects, and the second one's WIDTH is the information.
#
# ⛔ INDETERMINATE IS PAINTED, NOT OMITTED. An empty track and a 0%-full track are the same picture,
# and the whole reason `den <= 0` exists is that "I do not know" and "nothing has happened yet" are
# different facts. `held` is rupa's own token for exactly this state — its field comment reads
# "pending / sandbox / held" — so the bar says *pending* in the palette's own vocabulary rather than
# in a colour dhancha invented. It also puts `held` to work: rupa published it and 0.9.20 bound it
# with nothing in the toolkit using it.
#
# ⚠ HANDED THE INHERITED CLIP, not an intersected child clip — unlike `dh_draw_list_selection`,
# which paints a CHILD's rect and therefore needs the narrower one. A PROGRESS has no children.
# ⚠ `dh_fill_rect_clip`, never `sd_fill_rect`: a bar inside a scrolled list must be cut by the
# viewport like everything else, and the bare sadish call does not know about the clip.
# ⭐⭐ THE SCRIM (0.9.23) — a REAL translucent veil, as of sadish 0.5.3 and rupa 0.1.6.
#
# ⚠ THIS SHIPPED AS A SCANLINE DITHER FOR ABOUT AN HOUR, AND THE REASON IT DID IS WORTH KEEPING.
# sadish had no fill that read its destination — every span writer stored four bytes per pixel and
# never loaded — and `sd_alpha_of` maps a 0 alpha byte to **opaque**, so `sd_rgba(0,0,0,128)` handed
# to a fill painted SOLID BLACK. The honest options were an opaque panel (hides rather than dims), a
# hand-written coverage buffer through `sd_canvas_blit` (bypasses the clip stack and allocates a
# screenful per frame), or 50% coverage at scanline granularity. The dither shipped.
# ⛔ IT WAS NOT A LIMIT, IT WAS TWO UNFINISHED REPOS. `sd_fill_rect_blend` (sadish 0.5.3) is a fill
# that composites source-over, and `scrim` / `scrim_a` (rupa 0.1.6) are the palette's own answer to
# how far the page recedes. Both were a short change away in repos this stack owns. Calling that a
# limitation was wrong, and the dither is gone.
#
# ⛔ THE COLOUR AND THE ALPHA BOTH COME FROM THE THEME, and they are not interchangeable: the dark
# grounds dim with the void at 70%, the light grounds with their own INK at 40%. The void at 70% over
# rice paper would black the page out rather than let it recede — which is exactly why this is a
# per-theme token and not one number chosen here.
# ⚠ HANDED THE INHERITED CLIP, like `dh_draw_progress` and unlike `dh_draw_list_selection`: it paints
# its OWN rect, not a child's.
fn dh_draw_scrim(sds, x, y, w, h, clx, cly, clw, clh): i64 {
    # ⚠ Intersect by hand: `sd_fill_rect_blend` is a sadish primitive and knows nothing about
    # dhancha's clip stack, so the rect handed to it must already be the visible part.
    var x0 = x;
    var y0 = y;
    var x1 = x + w;
    var y1 = y + h;
    if (x0 < clx) { x0 = clx; }
    if (y0 < cly) { y0 = cly; }
    if (x1 > clx + clw) { x1 = clx + clw; }
    if (y1 > cly + clh) { y1 = cly + clh; }
    if (x1 <= x0) { return 0; }
    if (y1 <= y0) { return 0; }
    return sd_fill_rect_blend(sds, x0, y0, x1 - x0, y1 - y0, dh_theme_scrim(), dh_theme_scrim_a());
}

fn dh_draw_progress(sds, wgt, x, y, w, h, clx, cly, clw, clh): i64 {
    var p = dh_progress_permille(wgt);
    if (p < 0) {
        return dh_fill_rect_clip(sds, x, y, w, h, dh_theme_held(), clx, cly, clw, clh);
    }
    dh_fill_rect_clip(sds, x, y, w, h, dh_theme_line(), clx, cly, clw, clh);
    # ⚠ MULTIPLY THEN DIVIDE, the house convention the flex distributor already uses. At p == 1000
    # this is EXACTLY `w`, so a finished bar leaves no track pixel at the right edge — the off-by-one
    # that would otherwise make "done" and "nearly done" look the same.
    var fw = w * p / 1000;
    if (fw <= 0) { return 0; }
    return dh_fill_rect_clip(sds, x, y, fw, h, dh_theme_accent(), clx, cly, clw, clh);
}

# The selected GRID cell's highlight. ⚠ Same split as a list's: `accent` when the grid holds focus,
# `line` when it does not — two grids side by side must say which one the arrow keys drive, and a
# muted highlight is how a pane that is merely *remembering* a selection says so.
# ⛔ FROM THE CELL'S LAID-OUT BOX, never from the wrap arithmetic. Recomputing it here would be a
# second answer to "where is cell i", free to disagree with the one the cell was drawn at.
fn dh_draw_grid_selection(sds, wgt, clx, cly, clw, clh): i64 {
    var sel = dh_widget_sel(wgt);
    if (sel < 0) { return 0; }
    var cell = dh_grid_cell_at(wgt, sel);
    if (cell == 0) { return 0; }
    var col = dh_theme_line();
    if (dh_focus_within(wgt) == 1) { col = dh_theme_accent(); }
    return dh_fill_rect_clip(sds, dh_widget_x(cell), dh_widget_y(cell),
      dh_widget_w(cell), dh_widget_h(cell), col, clx, cly, clw, clh);
}

fn dh_draw_list_selection(sds, wgt, clx, cly, clw, clh): i64 {
    var sel = dh_widget_sel(wgt);
    if (sel < 0) { return 0; }
    var row = dh_list_row_at(wgt, sel);
    if (row == 0) { return 0; }
    var col = dh_theme_line();
    if (dh_focus_within(wgt) == 1) { col = dh_theme_accent(); }
    var rx = dh_widget_x(row);
    var ry = dh_widget_y(row);
    var rw = dh_widget_w(row);
    var rh = dh_widget_h(row);
    return dh_fill_rect_clip(sds, rx, ry, rw, rh, col, clx, cly, clw, clh);
}

# @public — render `surf`'s widget tree into a sadish SdSurface and return it (BGRA pixels; the
# caller can present/PPM it). `font` may be 0. Returns 0 on a bad surface or on OOM.
#
# ⛔⛔ THE RETURNED SURFACE IS OWNED BY `surf` AND IS REUSED ACROSS CALLS (0.9.14). THIS IS A
# CONTRACT CHANGE: until 0.9.13 every call allocated a brand-new `sd_surface_new`, so two renders of
# the same DhSurface produced two independent images. **They are now the same object**, and a caller
# holding the result of an earlier render sees it overwritten by the next one.
# ⇒ A caller that genuinely wants two images at once must render into **two DhSurfaces**. That is
# strictly clearer than the old behaviour, where the aliasing question was invisible because the
# answer was always "no" — and always cost a full-size buffer to say so.
#
# ⚠ WHY THIS IS WORTH A CONTRACT CHANGE. `lib/alloc.cyr` is a bump allocator with **no `free()`**, so
# the per-call `sd_surface_new` was not a transient — it was retained for the life of the process,
# every frame, forever. Measured against crab at 380x220: **334,432 B per frame**, which after
# 0.9.13's fix was **81 % of the whole frame cost**. An immediate-mode toolkit that cannot repaint
# without leaking a screenful cannot host an animation, a progress bar or a clock.
#
# ⭐ THE DIMENSION CHECK IS LIVE AS OF 0.9.17, AND IT WAS WRITTEN BEFORE ANYTHING COULD REACH IT.
# Through 0.9.14–0.9.16 there was no `dh_surface_resize`, so `w`/`h` could not change on a live
# DhSurface and this branch was **unreachable** — deleting it did not fail `draw_test`, which was
# measured and said out loud rather than glossed. It was kept because `WINDOW_CONFIGURE` (0.9.12)
# exists precisely so clients can resize, and whoever added that entry point would otherwise have had
# to remember to invalidate this cache. `dh_surface_resize` landed, the branch became reachable, and
# `draw_test` S) now pins it: deleting these four lines fails three checks.
# ⇒ Correct by construction beat correct by "nothing calls resize yet", and the bill came due in three
# releases rather than never.
# ⚠ On a miss the previous target is ABANDONED, not freed — there is nothing to free it with. A
# resize therefore costs one screenful, once, which is the right trade against leaking one per frame.
fn dh_surface_render(surf, font): i64 {
    if (surf == 0) { return 0; }
    var w = dh_surface_width(surf);
    var h = dh_surface_height(surf);
    var sds = load64(surf + DH_S_SDS);
    if (sds != 0) {
        if (sd_surface_width(sds) != w) { sds = 0; }
    }
    if (sds != 0) {
        if (sd_surface_height(sds) != h) { sds = 0; }
    }
    if (sds == 0) {
        sds = sd_surface_new(w, h);
        # ⚠ GUARD ADDED 0.9.14. The old body passed `sd_surface_new`'s result straight into
        # `sd_clear` without checking it, so an OOM here dereferenced 0 instead of returning it.
        if (sds == 0) { return 0; }
        store64(surf + DH_S_SDS, sds);
    }
    sd_clear(sds, dh_theme_bg());          # the active rupa theme's desktop void
    # ⭐ `sd_clear` fills EVERY pixel of the surface (`sd_fill_rect(s, 0, 0, w, h, …)`), which is what
    # makes reuse pixel-identical to a fresh allocation: no residue from the previous frame can
    # survive it. If that ever stops being true, reuse stops being safe.
    var root = dh_surface_root(surf);
    if (root != 0) {
        # The root clip is the surface itself — every widget is bounded by the thing it is drawn on.
        dh_draw_widget(sds, root, font, 0, 0, w, h);
    }
    return sds;
}
