[package]
name = "dhancha"
version = "${file:VERSION}"
description = "dhancha (ढाँचा — framework) — pure-Cyrius client-side widget toolkit / desktop app framework for AGNOS (Qt/GTK-equivalent): widget tree, box/flex layout, event loop, input dispatch (keyboard/pointer/focus/drag-drop). Apps build UIs here; draws via sadish + rekha + kashi + rupa; presents client surfaces over setu to the aethersafha compositor."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/dhancha"
language = "cyrius"
cyrius = "6.7.18"
# ⛔ THIS IS NOT THE ONLY COMPILER THAT READS src/ (0.11.0). Consumers compile `dist/dhancha.cyr` on
# THEIR pins, and crab is on 6.6.6. Most 6.7 syntax fails loudly there, but a lone `!` does not: below
# 6.7.3 the lexer drops it, so `if (!ok)` compiles as `if (ok)`. MEASURED, one source: exits 7 on 6.6.6
# and 6.6.20, 3 on 6.7.9, no warning on any. CI's `No lone ! in src/` step holds this until no consumer
# is below 6.7.3. Spell it `(x == 0)`, as this code always has.

# dhancha is a library — no CLI binary. `cyrius build` targets a smoke
# program that links the full include chain to prove lib.cyr parses clean.
# It is the CLIENT-side widget toolkit (Qt/GTK-equivalent) — the counterpart
# to aethersafha (the compositor/server). Desktop apps build UIs on dhancha
# instead of hand-rolling raw GPU + a raw compositor connection the way puka
# (the first windowed program) does today; dhancha is the spiritual extraction
# of puka's windowing code.
[build]
entry = "programs/smoke.cyr"
output = "build/dhancha-smoke"

# `cyrius coverage` reads tests/**/*.tcyr by default and this repo has none, so without this it
# reports 0/272. Every RUN suite is a coverage entry: 189/272 fns, 15/17 files at 0.10.5.
# ⚠ TEXT coverage — which public fns a suite NAMES, not what it executes.
[coverage]
programs = ["programs/*_test.cyr"]

# `[lib]` feeds `cyrius distlib` — module order matters: stdlib first
# (declared in src/lib.cyr), then domain modules in dependency order.
# error.cyr is dep-free; widget/layout/event/surface build on it. Don't
# reorder without re-running `cyrius distlib` and verifying the concatenated
# bundle still compiles clean.
[lib]
# ⛔⛔ THE CLIENT LAYER WAS MISSING FROM THIS LIST UNTIL 0.9.4, AND THAT IS WHY NO APP USED IT.
# The bundle shipped the widget/layout/event/draw half and NONE of the connection half, so a consumer
# resolving `dist/dhancha.cyr` got no `dh_client_connect`, no `dh_setu_*`, no input decode — the symbols
# simply did not exist downstream. crab was not bypassing the toolkit out of habit: `dh_client_connect`
# was UNDEFINED in its build, so hand-rolling setu was the only option available to it.
# ⇒ A toolkit whose README promises apps need not "hand-roll a raw compositor connection" has to SHIP
# the connection. Measured: adding these three turned crab's build from
# `2 reachable undefined function(s)` into a clean link.
# ⚠ ORDER IS THE INCLUDE CHAIN, not alphabetical — `dh_client.cyr` sits last because it composes
# `setu_client` + `setu_input` + `surface`, and its own header names that order.
# ⚠ These reference `setu_*`, so a consumer of this bundle MUST also declare `[deps.setu]` (>= 0.8.5 for
# the agnos channel band). That coupling is real and is the point: the client half is setu's wire.
# ⛔ `dist/dhancha.deps` IS GONE (0.10.5), AND MUST NOT BE HAND-WRITTEN BACK. Since cyrius 6.6.18 a
# sidecar is what the compile-verify proves and nothing more, and `[deps] stdlib` no longer reaches it.
# This bundle needs no stdlib leaf its five named deps do not already bring in their requires blocks,
# so `distlib` writes no file. A consumer declares sadish, rupa, rekha, kashi and setu, as it already had
# to; it inherits no stdlib leaf from this repo. `cyrius distlib --check` fails on a sidecar that returns.
modules = [
    "src/error.cyr",
    "src/widget.cyr",
    "src/layout.cyr",
    "src/list.cyr",
    "src/grid.cyr",
    "src/menu.cyr",
    "src/overlay.cyr",
    "src/progress.cyr",
    "src/event.cyr",
    "src/canvas.cyr",
    # ⚠ AFTER event.cyr — textinput.cyr reads `DhKey`, which event.cyr declares. The fold is a
    # concatenation, so a module using another's enum must follow it. `cyrius distlib` reports this
    # as an undefined-function warning on `dh_text_char_index` (surface.cyr's caret call), not as an
    # ordering error, which is a confusing way to learn it.
    "src/textinput.cyr",
    "src/theme.cyr",
    "src/table.cyr",
    "src/surface.cyr",
    "src/setu_client.cyr",
    "src/setu_input.cyr",
    "src/dh_client.cyr",
]

[deps]
# Base stdlib set. `hashmap` + `fnptr` + `tagged` are pulled in now so the
# widget-registry / event-callback / dispatch bites have them ready.
stdlib = [
    "string",
    "fmt",
    "alloc",
    "io",
    "vec",
    "str",
    "syscalls",
    "assert",
    "bench",
    "args",
    "hashmap",
    "fnptr",
    "tagged",
]

# Draw-path deps: sadish (2D vector fills/strokes) + rekha (glyph outlines,
# which itself pulls sadish). The widget draw walks the tree filling
# backgrounds/borders via sadish and text via rekha. Pinned to git tags.
# ⛔ EVERY `path = "../sibling"` LINE BELOW IS DORMANT (0.10.3), AND STAYS THAT WAY IN A COMMIT.
# ⚠ WHAT A `path` DOES CHANGED AT cyrius 6.7.6. From there a default build ALWAYS builds the tag and
# checks its commit pin; a `path` beside a `tag` is a dev override, used only under `--local` or
# `CYRIUS_LOCAL=1` (`=setu,sadish` for some), and otherwise prints one hint naming the checkout it did
# not use. ⇒ Uncommenting a line does nothing on its own: uncomment it AND ask for local mode.
# Below 6.7.6 `path` won over `tag`, skipped the commit-pin verify, and made a green local build no
# evidence the declared tag resolved (0.10.1 found setu's tag stale under a green build for exactly
# that reason, and the 0.8.7/0.8.8 note in [deps.setu] is the earlier instance). That is the rule the
# ⚠ paragraphs below were written under, and they are the history of why each line exists. It still
# holds for a CONSUMER below 6.7.6: crab, on 6.6.6, builds its live `path` lines and not its tags.
# ⚠ A TAG MOVE RE-PINS BY DELETING `cyrius.lock`, THEN `cyrius deps`. cyrius keeps a moved tag's old
# `commit` row on purpose (fail-closed since 6.6.20, CYRIUS-2026-0030), `--lock` keeps it, `--locked`
# passes on it, and from 6.7.12 every resolve prints a `note:` naming it. Five deps, five `commit` lines.
# ⚠ No mabda and no Wayland, by design (0.10.4 corrects the older note here): dhancha draws on the CPU,
# the present buffer is GPU-visible on hardware through setu, and aethersafha composites it on the GPU;
# Wayland is refused, not ported (docs/development/sovereign-desktop.md).
[deps.sadish]
git = "https://github.com/MacCracken/sadish.git"
# ⚠ `path` added 0.9.23, for the same reason rupa carries one: without it dhancha can only build
# against a PUBLISHED sadish tag, so a local sadish fix cannot be exercised until it is pushed — and
# 0.9.23's scrim depends on `sd_fill_rect_blend`, which landed in sadish 0.5.3 minutes earlier.
# 0.10.0's scalable text depends on `sd_alloc_set` + `sd_canvas_blit_at`, which landed in sadish
# 0.5.5 the same way.
# ⛔⛔ FLOOR >= 0.5.5, HARD — AND BELOW IT THE BUILD IS EITHER REFUSED OR GOES GREEN AND FAULTS.
# `sd_alloc_set`, `sd_alloc_get` and `sd_canvas_blit_at` do not exist below 0.5.5. Which outcome a
# build gets is NOT "a direct call from the program vs one through the bundle": cyrius 6.6.4 judges
# each undefined name by its FIRST call site in code order — inside a function DCE keeps live it
# refuses (`error: refusing to emit binary with N reachable undefined function(s)`); inside a dead
# one it prints `warning: undefined function`, emits a binary that faults at the first real call,
# and never looks at the later sites. MEASURED against a `git archive` of sadish 0.5.4: this repo's
# smoke and arena_test build OK and run (no face reached); text_test and text_arena_test are
# refused; rekha's path_test builds OK and exits 132 (its first `sd_alloc(` site, rekha_err_new, is
# dead there); crab — no call of its own, `dh_draw_text_ink` reachable from main through
# lib/dhancha.cyr — is refused, 2 undefined. A consumer that vendors sadish itself (crab: tag-only
# 0.5.4 / rekha 0.3.7) must therefore bump BOTH tags before it can build against 0.10.0 at all.
# ⇒ Grep build output for `undefined function` before trusting a green build against a moved tag —
# the plain warning line is printed in both cases.
# 0.10.1 moved this pin 0.5.5 -> 0.11.2 (six sadish releases: styled strokes, gradient/pattern paint,
# inline SdPath/SdPolyline points, a per-operation flatten budget). Nothing dhancha calls changed
# shape — all 18 `sd_*` names it calls resolve with the same arity, and the `SdSurface` record that
# `dh_surface_wrap` hand-builds is still w/h/pixels/stride at 0/8/16/24, size 32. The 0.5.5 floor
# still stands beneath this pin. ⚠ rekha 0.9.0 pins sadish 0.11.2 exactly, so both vendored bundles
# are cut against ONE sadish; move the two together. Verified with this `path` line disabled: the
# 0.11.2 tag resolves from git and its `dist/sadish.cyr` is byte-identical to the sibling checkout.
# 0.10.5 moved this pin 0.11.2 -> 0.11.3, the tag cut for cyrius 6.6.20. The bundle's code is 0.11.2's
# but for `sadish_version` and a requires block (`syscalls`, `alloc`, `string`), so rekha 1.0.0, whose
# own pin still names 0.11.2, sits on the same sadish in every line it calls. The rule above is a rule
# about code, not tag numbers: a sadish move that changes code still moves rekha with it.
# 0.11.0 moved this pin 0.11.3 -> 0.12.0, the tag cut for cyrius 6.7.9: `sadish_version` is the only
# code line that moved, and rekha 1.1.0 names this same tag, so the two agree by tag again as well.
# 0.11.1 moved this pin 0.12.0 -> 0.12.1, the latest tag, cut for cyrius 6.7.18: `sadish_version` again.
# ⚠ dormant (0.10.3) — uncomment for local work on an unpushed sibling; never commit it live.
# path = "../sadish"
tag = "0.12.1"
modules = ["dist/sadish.cyr"]

# rupa (रूप — form / appearance) — the shared desktop theme-token core. Widgets +
# chrome draw with the active MUDRA / SHANTA theme (dh_theme_*), the SAME source the
# aethersafha compositor reads, so the toolkit matches the desktop. path=../rupa for
# local work until rupa is tagged.
[deps.rupa]
git = "https://github.com/MacCracken/rupa.git"
# ⚠ `path` — every other dep in this stack carries both; without it a local rupa change cannot be
# built against until it is pushed, which is how a burn ends up testing last week's tokens.
# ⚠ dormant (0.10.3) — uncomment for local work on an unpushed sibling; never commit it live.
# path = "../rupa"
# 0.2.1 is rupa's latest tag, cut for cyrius 6.7.18 (0.11.1's pin): no code line changed from 0.2.0.
tag = "0.2.1"
modules = ["dist/rupa.cyr"]

[deps.rekha]
git = "https://github.com/MacCracken/rekha.git"
# ⚠ `path` added 0.10.0, for the reason the sadish and setu blocks carry one: 0.10.0 needed rekha
# 0.3.10 before it was a pushed tag, and without `path` a local rekha cannot be built against until
# it is. The tag has been published since; the line stays for cross-repo work, as every other dep's
# does.
# ⚠ dormant (0.10.3) — uncomment for local work on an unpushed sibling; never commit it live.
# path = "../rekha"
# ⛔ FLOOR >= 0.3.10, HARD. rekha 0.3.10 draws its glyph scratch — the loca span, the point arrays,
# the outline record, a composite's merge buffers — from sadish's `sd_alloc` seam instead of the
# global heap. That is what lets this repo's frame arena own the WHOLE scalable-text cost: dhancha
# installs `dh_falloc` as sadish's hook around a text draw (surface.cyr), and every byte rekha asks
# for lands on the arena too. Against 0.3.6–0.3.9 the outlines still leak 136 B per glyph (70,856 B
# per composite glyph) onto the global heap, under the hook, per frame — MEASURED in rekha 0.3.10's
# release. 0.3.6's floor still stands beneath this one: `dh_text_advance` calls
# `rekha_char_advance_px`, which 0.3.5 does not define — `hhea`/`hmtx` were declared tags with no
# reader until 0.3.6, and against an older pin the scalable text path does not compile.
# 0.10.1 moved this pin 0.3.10 -> 0.9.0. The five `rekha_*` names dhancha calls (`font_open`,
# `char_to_glyph`, `char_to_sdpath`, `char_advance_px`, `units_per_em`) keep their arity; dhancha
# never reads `SdPath` internals, so the inline-point port rekha made for sadish 0.9.0 is not ours.
# 0.10.5 moved this pin 0.9.0 -> 1.0.0, the surface freeze and rekha's tag for cyrius 6.6.20: zero code
# lines of `dist/rekha.cyr` changed, and the sidecar it used to publish is gone (rekha ADR 0010).
# 0.11.0 moved this pin 1.0.0 -> 1.1.0, rekha's tag for cyrius 6.7.9: zero code lines changed again.
# 0.11.1 moved this pin 1.1.0 -> 1.1.2, the latest tag: 1.1.1 is the 6.7.18 cut and 1.1.2 a full audit, so
# unlike its neighbours this move is real code. No public signature changed, and two answers reach us:
# `rekha_units_per_em` is 0 for a `unitsPerEm` outside 16..16384 (the draw then returns, as it always
# did on 0), and `rekha_char_to_sdpath` is 0 for a refused glyph (`sd_fill_impl` guards a 0 path, so that
# glyph draws nothing and the pen still advances). ⚠ A hand-built test face needs a sane `head`; ours use 1000.
tag = "1.1.2"
modules = ["dist/rekha.cyr"]

# kashi (काशि) — the AGNOS system console font (full CP437, VGA 8x16). dh_draw_text
# BLITS these bitmap glyphs directly for its default (font=0) text — the same font
# the compositor chrome uses. rekha stays for scalable TrueType (font != 0).
[deps.kashi]
git = "https://github.com/MacCracken/kashi.git"
# ⚠ `path` — kashi is VENDORED (lib/kashi_font_data.cyr); every other dep in this stack carries both.
# ⚠ dormant (0.10.3) — uncomment for local work on an unpushed sibling; never commit it live.
# path = "../kashi"
# 1.1.1 (0.10.5's pin, its tag for cyrius 6.6.20) stops the glyph buffers reserving 8x what they use:
# -88,576 B in every binary that links this core. No glyph or signature changed.
# ⛔ FLOOR >= 1.1.0, HARD, FOR EVERY CONSUMER OF THIS BUNDLE (0.10.5). `dh_text_cp437` calls
# `kashi_cp437_from_unicode`, which does not exist below 1.1.0, so a consumer that vendors kashi itself
# has to be there too. It fails loudly: MEASURED on crab (cyrius 6.6.6, kashi tag 1.0.10), `refusing to
# emit binary with 1 reachable undefined function(s)` on Linux and agnos. The name has one call site,
# so the first-call-site rule in the sadish block cannot misjudge it. ⚠ A program that never reaches
# the draw builds with only the `undefined function` warning (this repo's smoke does), and has nothing
# to fault on. ⚠ Below cyrius 6.7.6 a live `path` hides a stale tag here exactly as it did for setu:
# crab, on 6.6.6, builds because of its `path = "../kashi"`, while its declared tag sits below this floor.
# 1.3.0 (0.11.1's pin, the latest tag, cut for cyrius 6.7.18) changes one code line of this core, a clamp
# in `kashi_cp437_from_unicode`'s search, which only bounds a read. The floor stays 1.1.0.
tag = "1.3.0"
# ⛔⛔ THE FREESTANDING CORE IS A MEASURED CHOICE, NOT A SHORTCUT (recorded 2026-08-17, kashi 1.0.6).
# kashi's ADR 0001 says stdlib-linked consumers should take the LIBRARY FACE, and this project links
# the full stdlib — so `src/font_data.cyr` looks like the wrong surface. Two reasons it is not:
#   1. Until kashi 1.0.6 the library face was UNCONSUMABLE. `src/lib.cyr` opens with
#      `include "src/font_data.cyr"`, a kashi-root-relative path that cannot resolve once vendored
#      into this repo's `lib/` — `error: cannot open include file: src/font_data.cyr`. kashi 1.0.6
#      adds `dist/kashi.cyr`, which fixes that, so the choice is now real.
#   2. It is still the core. MEASURED on dhancha: core 364,640 B vs full face 548,000 B —
#      **+183,360 (+50%)** for PSF/BDF/PCF import and a runtime font registry nothing here calls, and
#      `CYRIUS_DCE=1` reclaims NONE of it. This project uses `kashi_font_init` + `kashi_glyph_row`.
# ⇒ Switch to `modules = ["dist/kashi.cyr"]` only when this project needs runtime font LOADING.
# 0.10.5 adds `kashi_font_is_ready` + `kashi_cp437_from_unicode` to what it uses; both are in the core.
modules = ["src/font_data.cyr"]

# Display-protocol contract + reference CLIENT: setu (सेतु — bridge). The wire
# between this client and the aethersafha compositor — message types, codec, AND
# (since setu 0.2.0) the reference client transport (`setu_connect` /
# `setu_client_*`). dhancha's `DhClient` + `dh_setu_*` now DELEGATE to setu's
# client — one shared transport implementation, no duplication. Pinned to 0.3.0
# (the CROSS-PLATFORM TCP transport — item 3b; setu_cl_sockaddr dropped). All fns
# `setu_*` (no collision); stdlib needs are a subset of the set above.
# ⛔ That TCP transport is RETIRED (2026-08-03) as the WRONG PRIMITIVE for local display IPC —
# not because it failed: it connected and presented un-rigged post-`net_src_for` (agnos 1.56.34)
# on 2026-08-02 in QEMU at `-smp 1`. Replacement: the agnos socket (`anu`) — agnos
# `docs/development/planning/ipc.md` §9/§10.
[deps.setu]
git = "https://github.com/MacCracken/setu.git"
# ⚠ `path` added 2026-08-27, for the reason crab added one to this very dep in August: without it
# dhancha can only build against a PUBLISHED setu tag, so a protocol kind cannot be mapped until it is
# pushed — and the wheel needed setu, dhancha and crab moving together.
# ⚠ dormant (0.10.3) — uncomment for local work on an unpushed sibling; never commit it live.
# path = "../setu"
# ⛔⛔ 0.8.8 IS A HARD FLOOR, NOT A PREFERENCE — `SETU_INPUT_PTR_SCROLL` (kind 12) is an ENUM CONSTANT,
# and `cyrius distlib` compiles the generated bundle: an undefined *function* is downgraded to a
# warning (dhancha calls setu functions it does not carry), but an undefined *variable* is a hard
# error. So a stale tag here does not degrade — it fails the bundle build outright.
# ⚠ AND THAT IS EXACTLY HOW IT WAS FOUND. Locally `path` won then, and `../setu` was already 0.8.8, so
# every build and every test was green while this line still said 0.8.7; CI has no `../setu`, resolved
# the tag, and `dist/dhancha.cyr` would not compile. The manifest note below said a green local build
# is not evidence the declared graph resolves — this is that, measured.
# ⚠ 0.8.11 IS THE FLOOR `programs/poll_test.cyr` NOW GATES (0.10.5). Below it, on Linux,
# `setu_client_poll_input` read EOF and every error as "nothing pending", so `dh_client_poll_event`
# could not report a dead compositor. 0.9.1 is setu's latest tag, cut for cyrius 6.7.18: two agnos
# refusal messages now write their newline, and nothing else in the bundle moved.
tag = "0.9.1"
modules = ["dist/setu.cyr"]
