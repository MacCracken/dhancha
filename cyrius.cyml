[package]
name = "dhancha"
version = "${file:VERSION}"
description = "dhancha (ढाँचा — framework) — pure-Cyrius client-side widget toolkit / desktop app framework for AGNOS (Qt/GTK-equivalent): widget tree, box/flex layout, event loop, input dispatch (keyboard/pointer/focus/drag-drop). Apps build UIs here; draws via sadish + rekha + mabda; emits Wayland client surfaces for the aethersafha compositor."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/dhancha"
language = "cyrius"
cyrius = "6.5.21"

# dhancha is a library — no CLI binary. `cyrius build` targets a smoke
# program that links the full include chain to prove lib.cyr parses clean.
# It is the CLIENT-side widget toolkit (Qt/GTK-equivalent) — the counterpart
# to aethersafha (the compositor/server). Desktop apps build UIs on dhancha
# instead of hand-rolling raw GPU + raw Wayland the way puka (the first
# windowed program) does today; dhancha is the spiritual extraction of
# puka's windowing code.
[build]
entry = "programs/smoke.cyr"
output = "build/dhancha-smoke"

# `[lib]` feeds `cyrius distlib` — module order matters: stdlib first
# (declared in src/lib.cyr), then domain modules in dependency order.
# error.cyr is dep-free; widget/layout/event/surface build on it. Don't
# reorder without re-running `cyrius distlib` and verifying the concatenated
# bundle still compiles clean.
[lib]
# ⛔⛔ THE CLIENT LAYER WAS MISSING FROM THIS LIST UNTIL 0.9.4, AND THAT IS WHY NO APP USED IT.
# The bundle shipped the widget/layout/event/draw half and NONE of the connection half, so a consumer
# resolving `dist/dhancha.cyr` got no `dh_client_connect`, no `dh_setu_*`, no input decode — the symbols
# simply did not exist downstream. crab was not bypassing the toolkit out of habit: `dh_client_connect`
# was UNDEFINED in its build, so hand-rolling setu was the only option available to it.
# ⇒ A toolkit whose README promises apps need not "hand-roll a raw compositor connection" has to SHIP
# the connection. Measured: adding these three turned crab's build from
# `2 reachable undefined function(s)` into a clean link.
# ⚠ ORDER IS THE INCLUDE CHAIN, not alphabetical — `dh_client.cyr` sits last because it composes
# `setu_client` + `setu_input` + `surface`, and its own header names that order.
# ⚠ These reference `setu_*`, so a consumer of this bundle MUST also declare `[deps.setu]` (>= 0.8.5 for
# the agnos channel band). That coupling is real and is the point: the client half is setu's wire.
modules = [
    "src/error.cyr",
    "src/widget.cyr",
    "src/layout.cyr",
    "src/list.cyr",
    "src/event.cyr",
    "src/canvas.cyr",
    # ⚠ AFTER event.cyr — textinput.cyr reads `DhKey`, which event.cyr declares. The fold is a
    # concatenation, so a module using another's enum must follow it. `cyrius distlib` reports this
    # as an undefined-function warning on `dh_text_char_index` (surface.cyr's caret call), not as an
    # ordering error, which is a confusing way to learn it.
    "src/textinput.cyr",
    "src/theme.cyr",
    "src/surface.cyr",
    "src/setu_client.cyr",
    "src/setu_input.cyr",
    "src/dh_client.cyr",
]

[deps]
# Base stdlib set. `hashmap` + `fnptr` + `tagged` are pulled in now so the
# widget-registry / event-callback / dispatch bites have them ready.
stdlib = [
    "string",
    "fmt",
    "alloc",
    "io",
    "vec",
    "str",
    "syscalls",
    "assert",
    "bench",
    "args",
    "hashmap",
    "fnptr",
    "tagged",
]

# Draw-path deps: sadish (2D vector fills/strokes) + rekha (glyph outlines,
# which itself pulls sadish). The widget draw walks the tree filling
# backgrounds/borders via sadish and text via rekha. Pinned to git tags (the dev
# `path` overrides were dropped for reproducible builds; re-add
# `path = "../sibling"` locally for cross-repo work on uncommitted siblings).
# mabda (GPU) + the aethersafha Wayland commit are a later bite — CPU draw first.
[deps.sadish]
git = "https://github.com/MacCracken/sadish.git"
tag = "0.5.1"
modules = ["dist/sadish.cyr"]

# rupa (रूप — form / appearance) — the shared desktop theme-token core. Widgets +
# chrome draw with the active MUDRA / SHANTA theme (dh_theme_*), the SAME source the
# aethersafha compositor reads, so the toolkit matches the desktop. path=../rupa for
# local work until rupa is tagged.
[deps.rupa]
git = "https://github.com/MacCracken/rupa.git"
# ⚠ `path` — every other dep in this stack carries both; without it a local rupa change cannot be
# built against until it is pushed, which is how a burn ends up testing last week's tokens.
path = "../rupa"
tag = "0.1.3"
modules = ["dist/rupa.cyr"]

[deps.rekha]
git = "https://github.com/MacCracken/rekha.git"
tag = "0.3.4"
modules = ["dist/rekha.cyr"]

# kashi (काशि) — the AGNOS system console font (full CP437, VGA 8x16). dh_draw_text
# BLITS these bitmap glyphs directly for its default (font=0) text — the same font
# the compositor chrome uses. rekha stays for scalable TrueType (font != 0).
[deps.kashi]
git = "https://github.com/MacCracken/kashi.git"
# ⚠ `path` — kashi is VENDORED (lib/kashi_font_data.cyr); every other dep in this stack carries both.
path = "../kashi"
tag = "1.0.4"
modules = ["src/font_data.cyr"]

# Display-protocol contract + reference CLIENT: setu (सेतु — bridge). The wire
# between this client and the aethersafha compositor — message types, codec, AND
# (since setu 0.2.0) the reference client transport (`setu_connect` /
# `setu_client_*`). dhancha's `DhClient` + `dh_setu_*` now DELEGATE to setu's
# client — one shared transport implementation, no duplication. Pinned to 0.3.0
# (the CROSS-PLATFORM TCP transport — item 3b; setu_cl_sockaddr dropped). All fns
# `setu_*` (no collision); stdlib needs are a subset of the set above.
# ⛔ That TCP transport is RETIRED (2026-08-03) as the WRONG PRIMITIVE for local display IPC —
# not because it failed: it connected and presented un-rigged post-`net_src_for` (agnos 1.56.34)
# on 2026-08-02 in QEMU at `-smp 1`. Replacement: the agnos socket (`anu`) — agnos
# `docs/development/planning/ipc.md` §9/§10.
[deps.setu]
git = "https://github.com/MacCracken/setu.git"
tag = "0.8.6"
modules = ["dist/setu.cyr"]
