# programs/draw_test.cyr — RUN test for the widget-tree draw (sadish path).
#
# Builds a window (gray, BOX_V) containing a red box + a blue button, lays it
# out, renders into a sadish SdSurface (font=0, no text), and checks the
# background/border pixels. Exit code = failed checks. Validates dhancha's
# sadish integration end to end (tree → layout → sadish fills/strokes).

include "src/lib.cyr"

var g_fails = 0;

fn check(got, want): i64 {
    if (got == want) { return 0; }
    g_fails = g_fails + 1;
    return 1;
}

fn main(): i64 {
    alloc_init();
    var GRAY = sd_rgb(200, 200, 200);   # 0xC8C8C8 = 13158600
    var RED  = sd_rgb(255, 0, 0);       # 0xFF0000 = 16711680
    var BLUE = sd_rgb(0, 0, 255);       # 0x0000FF = 255

    var root = dh_widget_new(WINDOW);
    dh_widget_set_layout(root, BOX_V);
    dh_widget_set_bg(root, GRAY);
    var c0 = dh_widget_new(BOX);
    dh_widget_set_bg(c0, RED);
    dh_widget_set_pref(c0, 0, 15);
    var c1 = dh_widget_new(BUTTON);
    dh_widget_set_bg(c1, BLUE);
    dh_widget_set_pref(c1, 0, 15);
    dh_widget_add_child(root, c0);
    dh_widget_add_child(root, c1);

    var surf = dh_surface_new(40, 40);
    dh_surface_set_root(surf, root);
    dh_layout_apply(root, 40, 40);
    var sds = dh_surface_render(surf, 0);

    check(sd_surface_pixel_at(sds, 20, 35), 13158600);   # window gray (below children)
    check(sd_surface_pixel_at(sds, 20, 7), 16711680);    # box red
    check(sd_surface_pixel_at(sds, 20, 22), 255);        # button blue interior
    check(sd_surface_pixel_at(sds, 0, 22), dh_theme_line());   # button border (left edge, active theme's line colour)

    # ── R) THE RENDER TARGET IS REUSED, AND REUSE IS PIXEL-IDENTICAL (0.9.14) ──────
    # ⛔ Until 0.9.13 every `dh_surface_render` allocated a fresh `sd_surface_new` — 334,432 B at
    # crab's 380x220, retained forever, because the allocator has no `free()`. The target is now
    # cached on the DhSurface. These checks pin BOTH halves of that: the identity (so a caller
    # cannot be surprised by aliasing) and the equivalence (so reuse cannot leave residue).
    var again = dh_surface_render(surf, 0);
    check(again, sds);                                   # same object, not a new allocation

    # Re-render a DIFFERENT tree into the SAME surface, then restore the original and compare.
    # If `sd_clear` ever stops covering every pixel, the restored frame keeps residue and this fails.
    var alt = dh_widget_new(WINDOW);
    dh_widget_set_layout(alt, BOX_V);
    dh_widget_set_bg(alt, RED);                          # a full-window red wash
    dh_surface_set_root(surf, alt);
    dh_layout_apply(alt, 40, 40);
    dh_surface_render(surf, 0);
    check(sd_surface_pixel_at(sds, 20, 35), 16711680);   # the alt frame really did overwrite it

    # ⛔⛔ THE RESIDUE CHECK NEEDS A TREE THAT DOES *NOT* COVER THE SURFACE, AND THE FIRST DRAFT OF
    # THIS TEST DID NOT HAVE ONE. Every tree above paints its root across the full 40x40, so deleting
    # `sd_clear` from `dh_surface_render` left them all green — the frame was fully repainted either
    # way. A reuse test that only ever renders opaque full-surface trees cannot see residue, which is
    # the single failure mode reuse introduces and a fresh allocation could not have had.
    # ⇒ Render a root that paints NOTHING (`bg = -1`) with one short child, and read a pixel below it.
    var sparse = dh_widget_new(WINDOW);
    dh_widget_set_layout(sparse, BOX_V);
    dh_widget_set_bg(sparse, 0 - 1);                     # paints nothing at all
    var tiny = dh_widget_new(BOX);
    dh_widget_set_bg(tiny, BLUE);
    dh_widget_set_pref(tiny, 0, 10);
    dh_widget_add_child(sparse, tiny);
    dh_surface_set_root(surf, sparse);
    dh_layout_apply(sparse, 40, 40);
    dh_surface_render(surf, 0);
    # ⚠ Guard the guard: if the theme's background were red this check would pass vacuously.
    check(dh_theme_bg() == 16711680, 0);
    # y=35 is painted by nothing in `sparse`. With the clear it is the theme background; without it,
    # the red wash from the previous frame survives into a frame that never drew red.
    check(sd_surface_pixel_at(sds, 20, 35), dh_theme_bg());

    dh_surface_set_root(surf, root);
    dh_layout_apply(root, 40, 40);
    dh_surface_render(surf, 0);
    check(sd_surface_pixel_at(sds, 20, 35), 13158600);   # ...and the original frame comes back EXACT
    check(sd_surface_pixel_at(sds, 20, 7), 16711680);
    check(sd_surface_pixel_at(sds, 20, 22), 255);
    check(sd_surface_pixel_at(sds, 0, 22), dh_theme_line());

    # ⚠ TWO DhSurfaces STILL GIVE TWO IMAGES. This is the escape hatch the contract change leaves
    # open, and a caller that needs two frames at once depends on it holding.
    var surf2 = dh_surface_new(40, 40);
    dh_surface_set_root(surf2, alt);
    dh_layout_apply(alt, 40, 40);
    var sds2 = dh_surface_render(surf2, 0);
    check(sds2 == sds, 0);                               # distinct targets
    check(sd_surface_pixel_at(sds2, 20, 35), 16711680);  # surf2 holds the alt frame...
    check(sd_surface_pixel_at(sds, 20, 35), 13158600);   # ...and surf still holds its own

    # ── S) RESIZE — the target follows the surface to its new extent; T) is what that costs ────
    var rs2 = dh_surface_new(40, 40);
    dh_surface_set_root(rs2, root);
    dh_layout_apply(root, 40, 40);
    var before = dh_surface_render(rs2, 0);
    check(sd_surface_width(before), 40);

    check(dh_surface_resize(rs2, 80, 60), DHANCHA_OK);
    check(dh_surface_width(rs2), 80);
    check(dh_surface_height(rs2), 60);
    dh_layout_apply(root, 80, 60);
    var after = dh_surface_render(rs2, 0);
    check(sd_surface_width(after), 80);          # the target really was re-made at the new extent
    check(sd_surface_height(after), 60);
    check(after == before, 0);                   # ...and it is a DIFFERENT object

    # ⚠ AND IT IS STILL REUSED AT THE NEW SIZE — a resize must not turn every later frame back into
    # an allocation. Rendering again returns the same target.
    check(dh_surface_render(rs2, 0), after);

    # ⛔⛔ THE LATENT OVERFLOW 0.9.13 CREATED, AND THE REASON RESIZE MUST DROP THE PIXEL CACHE.
    # `dh_surface_pixels` allocates `w*h*4` on first ask and caches it. Growing the surface while
    # that cache stood would hand a caller a buffer sized for the OLD extent to write the NEW one —
    # a silent heap overflow into whatever the bump allocator placed after it. Nothing could reach it
    # while `w`/`h` were immutable; `dh_surface_resize` is what makes it reachable.
    var pxs = dh_surface_new(8, 8);
    var p_small = dh_surface_pixels(pxs);        # forces the 8x8x4 = 256 B allocation
    check(p_small != 0, 1);
    check(dh_surface_resize(pxs, 64, 64), DHANCHA_OK);
    var p_big = dh_surface_pixels(pxs);          # must be a NEW, larger buffer
    check(p_big != 0, 1);
    check(p_big == p_small, 0);                  # the stale-sized cache was dropped

    # --- refusals, and the no-op ---------------------------------------------------------------
    check(dh_surface_resize(0, 10, 10), DHANCHA_ERR_NO_SURFACE);
    check(dh_surface_resize(rs2, 0, 10), DHANCHA_ERR_BAD_ARG);
    check(dh_surface_resize(rs2, 10, 0), DHANCHA_ERR_BAD_ARG);
    check(dh_surface_resize(rs2, 0 - 1, 10), DHANCHA_ERR_BAD_ARG);
    check(dh_surface_width(rs2), 80);            # a refused resize changes nothing
    check(dh_surface_height(rs2), 60);
    # ⚠ Resizing to the SAME extent must not drop the caches — a compositor is free to re-send a
    # CONFIGURE with the size the client already has, and treating that as a change would throw away
    # a render target and a pixel buffer for nothing, every time.
    var same_px = dh_surface_pixels(rs2);
    check(dh_surface_resize(rs2, 80, 60), DHANCHA_OK);
    check(dh_surface_pixels(rs2), same_px);
    check(dh_surface_render(rs2, 0), after);

    # ── T) A SIZE CHANGE RE-USES THE BUFFER (0.12.0) ─────────────
    var rt = dh_surface_new(200, 100);
    var t0 = dh_surface_render(rt, 0);
    var t0px = sd_surface_pixels(t0);
    check(sd_surface_stride(t0), 800);
    # ⭐ A shrink keeps the object and the buffer, and packs the rows.
    check(dh_surface_resize(rt, 50, 20), DHANCHA_OK);
    check(dh_surface_render(rt, 0), t0);
    check(sd_surface_pixels(t0), t0px);
    check(sd_surface_width(t0), 50);
    check(sd_surface_height(t0), 20);
    check(sd_surface_stride(t0), 200);
    # ...and growing back inside it costs nothing either.
    var tg0 = alloc_used();
    check(dh_surface_resize(rt, 200, 100), DHANCHA_OK);
    check(dh_surface_render(rt, 0), t0);
    check(alloc_used() - tg0, 0);
    check(sd_surface_width(t0), 200);
    check(sd_surface_height(t0), 100);
    check(sd_surface_stride(t0), 800);
    # ⭐ THE WIDGETS DRAW AT THE NEW EXTENT: the last pixel of a re-pointed target is reachable.
    var tr = dh_widget_new(BOX);
    dh_widget_set_bg(tr, 0x00FF00);
    dh_widget_set_bounds(tr, 0, 0, 200, 100);
    dh_surface_set_root(rt, tr);
    dh_surface_render(rt, 0);
    var tgreen = sd_surface_pixel_at(t0, 199, 99);
    check(tgreen != sd_surface_pixel_at(t0, 200, 99), 1);        # off the surface: not the fill
    # ⛔ NOTHING OF THE LARGER FRAME SHOWS. A consumer presents `w * h * 4` contiguous bytes.
    dh_surface_set_root(rt, 0);
    check(dh_surface_resize(rt, 50, 20), DHANCHA_OK);
    dh_surface_render(rt, 0);
    var tvoid = load32(t0px);
    check(tvoid != tgreen, 1);
    var tdirty = 0;
    var tk = 0;
    while (tk < 50 * 20) {
        if (load32(t0px + tk * 4) != tvoid) { tdirty = tdirty + 1; }
        tk = tk + 1;
    }
    check(tdirty, 0);

    # ⭐⭐ A DRAG THAT GROWS: 500 sizes, 3 re-allocations, under four times the last frame.
    var dr = dh_surface_new(400, 300);
    var dt = dh_surface_render(dr, 0);
    var dg0 = alloc_used();
    var dswaps = 0;
    var dwrong = 0;
    var di = 1;
    while (di <= 500) {
        var dw = 400 + di;
        var dh2 = 300 + (di * 4) / 5;
        dh_surface_resize(dr, dw, dh2);
        var dn = dh_surface_render(dr, 0);
        if (dn != dt) { dswaps = dswaps + 1; dt = dn; }
        if (sd_surface_width(dn) != dw) { dwrong = dwrong + 1; }
        if (sd_surface_height(dn) != dh2) { dwrong = dwrong + 1; }
        if (sd_surface_stride(dn) != dw * 4) { dwrong = dwrong + 1; }
        di = di + 1;
    }
    check(dwrong, 0);
    check(dswaps, 3);
    check(alloc_used() - dg0 < 4 * 900 * 700 * 4, 1);
    # ⭐ AND A DRAG BACK AND FORTH, once the largest size has been seen, costs nothing at all.
    var dg1 = alloc_used();
    di = 0;
    while (di < 1000) {
        dh_surface_resize(dr, 300 + (di % 5) * 100, 200 + (di % 7) * 60);
        check(dh_surface_render(dr, 0), dt);
        di = di + 1;
    }
    check(alloc_used() - dg1, 0);

    # ⛔ AN EXTENT THAT WRAPS IS REFUSED, NOT RE-POINTED: 2^35 x 2^29 is an area of 0.
    var wr = dh_surface_new(10, 10);
    var wt = dh_surface_render(wr, 0);
    check(dh_surface_resize(wr, 1 << 35, 1 << 29), DHANCHA_OK);
    check(dh_surface_render(wr, 0), 0);
    check(sd_surface_width(wt), 10);
    check(dh_surface_resize(wr, 1 << 29, 1 << 35), DHANCHA_OK);
    check(dh_surface_render(wr, 0), 0);
    check(sd_surface_height(wt), 10);
    check(dh_surface_resize(wr, 1 << 15, 1 << 15), DHANCHA_OK);  # too large a product, and no wrap
    check(dh_surface_render(wr, 0), 0);
    check(sd_surface_width(wt), 10);
    check(dh_surface_resize(wr, 10, 10), DHANCHA_OK);
    check(dh_surface_render(wr, 0), wt);

    # ⚠ DOUBLING MAY NOT REFUSE WHAT THE EXACT SIZE WOULD MEET.
    var fb = dh_surface_new(500, 200);                           # 100,000 px
    var ft = dh_surface_render(fb, 0);
    var amax = ALLOC_MAX;
    ALLOC_MAX = 500000;                                          # room for 105,000 px, not 200,000
    check(dh_surface_resize(fb, 500, 210), DHANCHA_OK);
    var fbn = dh_surface_render(fb, 0);
    ALLOC_MAX = amax;
    check(fbn != 0, 1);
    check(fbn != ft, 1);
    check(sd_surface_height(fbn), 210);
    # ⛔ AND THE ROOM IS WHAT WAS OBTAINED: 180,000 px does not fit the 105,000 this buffer holds.
    check(dh_surface_resize(fb, 450, 400), DHANCHA_OK);
    var fbg = dh_surface_render(fb, 0);
    check(fbg != 0, 1);
    check(fbg != fbn, 1);

    # ⚠ OUT OF MEMORY RETURNS 0 AND THE TARGET IT HAD IS STILL GOOD.
    var oo = dh_surface_new(20, 20);
    var ot = dh_surface_render(oo, 0);
    ALLOC_MAX = 64;
    check(dh_surface_resize(oo, 40, 40), DHANCHA_OK);
    var oz = dh_surface_render(oo, 0);
    ALLOC_MAX = amax;
    check(oz, 0);
    check(sd_surface_width(ot), 20);
    check(dh_surface_resize(oo, 20, 20), DHANCHA_OK);
    check(dh_surface_render(oo, 0), ot);

    if (g_fails == 0) {
        var ok = "draw_test: PASS (bg + border render, reused target)\n";
        syscall(1, 1, ok, strlen(ok));
    } else {
        var bad = "draw_test: FAIL\n";
        syscall(1, 2, bad, strlen(bad));
    }
    return g_fails;
}

var exit_code = main();
syscall(60, exit_code);
