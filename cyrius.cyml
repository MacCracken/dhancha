[package]
name = "dhancha"
version = "${file:VERSION}"
description = "dhancha (ढाँचा — framework) — pure-Cyrius client-side widget toolkit / desktop app framework for AGNOS (Qt/GTK-equivalent): widget tree, box/flex layout, event loop, input dispatch (keyboard/pointer/focus/drag-drop). Apps build UIs here; draws via sadish + rekha + mabda; emits Wayland client surfaces for the aethersafha compositor."
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/dhancha"
language = "cyrius"
cyrius = "6.6.4"

# dhancha is a library — no CLI binary. `cyrius build` targets a smoke
# program that links the full include chain to prove lib.cyr parses clean.
# It is the CLIENT-side widget toolkit (Qt/GTK-equivalent) — the counterpart
# to aethersafha (the compositor/server). Desktop apps build UIs on dhancha
# instead of hand-rolling raw GPU + raw Wayland the way puka (the first
# windowed program) does today; dhancha is the spiritual extraction of
# puka's windowing code.
[build]
entry = "programs/smoke.cyr"
output = "build/dhancha-smoke"

# `[lib]` feeds `cyrius distlib` — module order matters: stdlib first
# (declared in src/lib.cyr), then domain modules in dependency order.
# error.cyr is dep-free; widget/layout/event/surface build on it. Don't
# reorder without re-running `cyrius distlib` and verifying the concatenated
# bundle still compiles clean.
[lib]
# ⛔⛔ THE CLIENT LAYER WAS MISSING FROM THIS LIST UNTIL 0.9.4, AND THAT IS WHY NO APP USED IT.
# The bundle shipped the widget/layout/event/draw half and NONE of the connection half, so a consumer
# resolving `dist/dhancha.cyr` got no `dh_client_connect`, no `dh_setu_*`, no input decode — the symbols
# simply did not exist downstream. crab was not bypassing the toolkit out of habit: `dh_client_connect`
# was UNDEFINED in its build, so hand-rolling setu was the only option available to it.
# ⇒ A toolkit whose README promises apps need not "hand-roll a raw compositor connection" has to SHIP
# the connection. Measured: adding these three turned crab's build from
# `2 reachable undefined function(s)` into a clean link.
# ⚠ ORDER IS THE INCLUDE CHAIN, not alphabetical — `dh_client.cyr` sits last because it composes
# `setu_client` + `setu_input` + `surface`, and its own header names that order.
# ⚠ These reference `setu_*`, so a consumer of this bundle MUST also declare `[deps.setu]` (>= 0.8.5 for
# the agnos channel band). That coupling is real and is the point: the client half is setu's wire.
modules = [
    "src/error.cyr",
    "src/widget.cyr",
    "src/layout.cyr",
    "src/list.cyr",
    "src/grid.cyr",
    "src/menu.cyr",
    "src/overlay.cyr",
    "src/progress.cyr",
    "src/event.cyr",
    "src/canvas.cyr",
    # ⚠ AFTER event.cyr — textinput.cyr reads `DhKey`, which event.cyr declares. The fold is a
    # concatenation, so a module using another's enum must follow it. `cyrius distlib` reports this
    # as an undefined-function warning on `dh_text_char_index` (surface.cyr's caret call), not as an
    # ordering error, which is a confusing way to learn it.
    "src/textinput.cyr",
    "src/theme.cyr",
    "src/table.cyr",
    "src/surface.cyr",
    "src/setu_client.cyr",
    "src/setu_input.cyr",
    "src/dh_client.cyr",
]

[deps]
# Base stdlib set. `hashmap` + `fnptr` + `tagged` are pulled in now so the
# widget-registry / event-callback / dispatch bites have them ready.
stdlib = [
    "string",
    "fmt",
    "alloc",
    "io",
    "vec",
    "str",
    "syscalls",
    "assert",
    "bench",
    "args",
    "hashmap",
    "fnptr",
    "tagged",
]

# Draw-path deps: sadish (2D vector fills/strokes) + rekha (glyph outlines,
# which itself pulls sadish). The widget draw walks the tree filling
# backgrounds/borders via sadish and text via rekha. Pinned to git tags (the dev
# `path` overrides were dropped for reproducible builds; re-add
# `path = "../sibling"` locally for cross-repo work on uncommitted siblings).
# mabda (GPU) + the aethersafha Wayland commit are a later bite — CPU draw first.
[deps.sadish]
git = "https://github.com/MacCracken/sadish.git"
# ⚠ `path` added 0.9.23, for the same reason rupa carries one: without it dhancha can only build
# against a PUBLISHED sadish tag, so a local sadish fix cannot be exercised until it is pushed — and
# 0.9.23's scrim depends on `sd_fill_rect_blend`, which landed in sadish 0.5.3 minutes earlier.
# 0.10.0's scalable text depends on `sd_alloc_set` + `sd_canvas_blit_at`, which landed in sadish
# 0.5.5 the same way.
# ⛔ `path` WINS over `tag`, so a green build here is NOT evidence the declared tag resolves.
# Re-verify with every `path` line disabled before any release that moves these tags.
# ⛔⛔ FLOOR >= 0.5.5, HARD — AND BELOW IT THE BUILD IS EITHER REFUSED OR GOES GREEN AND FAULTS.
# `sd_alloc_set`, `sd_alloc_get` and `sd_canvas_blit_at` do not exist below 0.5.5. Which outcome a
# build gets is NOT "a direct call from the program vs one through the bundle": cyrius 6.6.4 judges
# each undefined name by its FIRST call site in code order — inside a function DCE keeps live it
# refuses (`error: refusing to emit binary with N reachable undefined function(s)`); inside a dead
# one it prints `warning: undefined function`, emits a binary that faults at the first real call,
# and never looks at the later sites. MEASURED against a `git archive` of sadish 0.5.4: this repo's
# smoke and arena_test build OK and run (no face reached); text_test and text_arena_test are
# refused; rekha's path_test builds OK and exits 132 (its first `sd_alloc(` site, rekha_err_new, is
# dead there); crab — no call of its own, `dh_draw_text_ink` reachable from main through
# lib/dhancha.cyr — is refused, 2 undefined. A consumer that vendors sadish itself (crab: tag-only
# 0.5.4 / rekha 0.3.7) must therefore bump BOTH tags before it can build against 0.10.0 at all.
# ⇒ Grep build output for `undefined function` before trusting a green build against a moved tag —
# the plain warning line is printed in both cases.
path = "../sadish"
tag = "0.5.5"
modules = ["dist/sadish.cyr"]

# rupa (रूप — form / appearance) — the shared desktop theme-token core. Widgets +
# chrome draw with the active MUDRA / SHANTA theme (dh_theme_*), the SAME source the
# aethersafha compositor reads, so the toolkit matches the desktop. path=../rupa for
# local work until rupa is tagged.
[deps.rupa]
git = "https://github.com/MacCracken/rupa.git"
# ⚠ `path` — every other dep in this stack carries both; without it a local rupa change cannot be
# built against until it is pushed, which is how a burn ends up testing last week's tokens.
path = "../rupa"
tag = "0.1.7"
modules = ["dist/rupa.cyr"]

[deps.rekha]
git = "https://github.com/MacCracken/rekha.git"
# ⚠ `path` added 0.10.0, for the reason the sadish and setu blocks carry one: 0.10.0 needs rekha
# 0.3.10, which is not yet a pushed tag, and without `path` a local rekha cannot be built against
# until it is. ⛔ `path` WINS over `tag`, so a green build here is NOT evidence the declared tag
# resolves — re-verify with this line disabled before any release that moves the tag.
path = "../rekha"
# ⛔ FLOOR >= 0.3.10, HARD. rekha 0.3.10 draws its glyph scratch — the loca span, the point arrays,
# the outline record, a composite's merge buffers — from sadish's `sd_alloc` seam instead of the
# global heap. That is what lets this repo's frame arena own the WHOLE scalable-text cost: dhancha
# installs `dh_falloc` as sadish's hook around a text draw (surface.cyr), and every byte rekha asks
# for lands on the arena too. Against 0.3.6–0.3.9 the outlines still leak 136 B per glyph (70,856 B
# per composite glyph) onto the global heap, under the hook, per frame — MEASURED in rekha 0.3.10's
# release. 0.3.6's floor still stands beneath this one: `dh_text_advance` calls
# `rekha_char_advance_px`, which 0.3.5 does not define — `hhea`/`hmtx` were declared tags with no
# reader until 0.3.6, and against an older pin the scalable text path does not compile.
tag = "0.3.10"
modules = ["dist/rekha.cyr"]

# kashi (काशि) — the AGNOS system console font (full CP437, VGA 8x16). dh_draw_text
# BLITS these bitmap glyphs directly for its default (font=0) text — the same font
# the compositor chrome uses. rekha stays for scalable TrueType (font != 0).
[deps.kashi]
git = "https://github.com/MacCracken/kashi.git"
# ⚠ `path` — kashi is VENDORED (lib/kashi_font_data.cyr); every other dep in this stack carries both.
path = "../kashi"
tag = "1.0.8"
# ⛔⛔ THE FREESTANDING CORE IS A MEASURED CHOICE, NOT A SHORTCUT (recorded 2026-08-17, kashi 1.0.6).
# kashi's ADR 0001 says stdlib-linked consumers should take the LIBRARY FACE, and this project links
# the full stdlib — so `src/font_data.cyr` looks like the wrong surface. Two reasons it is not:
#   1. Until kashi 1.0.6 the library face was UNCONSUMABLE. `src/lib.cyr` opens with
#      `include "src/font_data.cyr"`, a kashi-root-relative path that cannot resolve once vendored
#      into this repo's `lib/` — `error: cannot open include file: src/font_data.cyr`. kashi 1.0.6
#      adds `dist/kashi.cyr`, which fixes that, so the choice is now real.
#   2. It is still the core. MEASURED on dhancha: core 364,640 B vs full face 548,000 B —
#      **+183,360 (+50%)** for PSF/BDF/PCF import and a runtime font registry nothing here calls, and
#      `CYRIUS_DCE=1` reclaims NONE of it. This project uses `kashi_font_init` + `kashi_glyph_row`.
# ⇒ Switch to `modules = ["dist/kashi.cyr"]` only when this project needs runtime font LOADING.
modules = ["src/font_data.cyr"]

# Display-protocol contract + reference CLIENT: setu (सेतु — bridge). The wire
# between this client and the aethersafha compositor — message types, codec, AND
# (since setu 0.2.0) the reference client transport (`setu_connect` /
# `setu_client_*`). dhancha's `DhClient` + `dh_setu_*` now DELEGATE to setu's
# client — one shared transport implementation, no duplication. Pinned to 0.3.0
# (the CROSS-PLATFORM TCP transport — item 3b; setu_cl_sockaddr dropped). All fns
# `setu_*` (no collision); stdlib needs are a subset of the set above.
# ⛔ That TCP transport is RETIRED (2026-08-03) as the WRONG PRIMITIVE for local display IPC —
# not because it failed: it connected and presented un-rigged post-`net_src_for` (agnos 1.56.34)
# on 2026-08-02 in QEMU at `-smp 1`. Replacement: the agnos socket (`anu`) — agnos
# `docs/development/planning/ipc.md` §9/§10.
[deps.setu]
git = "https://github.com/MacCracken/setu.git"
# ⚠ `path` added 2026-08-27, for the reason crab added one to this very dep in August: without it
# dhancha can only build against a PUBLISHED setu tag, so a protocol kind cannot be mapped until it is
# pushed — and the wheel needed setu, dhancha and crab moving together. ⛔ `path` WINS over `tag`, so a
# green build here is NOT evidence the declared graph resolves; re-verify the tag against setu's
# VERSION at every cut, and prefer disabling `path` and re-resolving over trusting the local tree.
path = "../setu"
# ⛔⛔ 0.8.8 IS A HARD FLOOR, NOT A PREFERENCE — `SETU_INPUT_PTR_SCROLL` (kind 12) is an ENUM CONSTANT,
# and `cyrius distlib` compiles the generated bundle: an undefined *function* is downgraded to a
# warning (dhancha calls setu functions it does not carry), but an undefined *variable* is a hard
# error. So a stale tag here does not degrade — it fails the bundle build outright.
# ⚠ AND THAT IS EXACTLY HOW IT WAS FOUND. Locally `path` wins and `../setu` was already 0.8.8, so
# every build and every test was green while this line still said 0.8.7; CI has no `../setu`, resolved
# the tag, and `dist/dhancha.cyr` would not compile. The manifest note below said a green local build
# is not evidence the declared graph resolves — this is that, measured.
tag = "0.8.9"
modules = ["dist/setu.cyr"]
