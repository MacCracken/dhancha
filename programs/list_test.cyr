# programs/list_test.cyr — RUN test for the LIST container: scroll clamping, selection, the
# keep-selected-visible rule, and the draw/input clip agreement.
# Exit code = failed checks.
#
# ⚠ THE INTERESTING CASES ARE ALL EDGES. A list that scrolls when you drag it is easy; the bugs
# live at "content shorter than the viewport", "selection already visible", and "row half off the
# bottom". Those are what this file is mostly made of.

include "src/lib.cyr"

var g_fails = 0;

var g_checks = 0;

# ⚠ NAMES THE FAILING CHECK. This suite reported only a count, so a failure meant bisecting 100+
# assertions by hand — and it drives a long stateful sequence where the index is most of the answer.
fn check(got, want): i64 {
    g_checks = g_checks + 1;
    if (got == want) { return 0; }
    g_fails = g_fails + 1;
    var m = "  list_test: check #";
    print(m, strlen(m));
    fmt_int(g_checks);
    var m2 = " failed: got ";
    print(m2, strlen(m2));
    fmt_int(got);
    var m3 = " want ";
    print(m3, strlen(m3));
    fmt_int(want);
    print("\n", 1);
    return 1;
}

# Build a list of `n` rows, row height 20, no gap/pad, laid out `view_h` tall.
# Count pixels of exactly `col` in a rectangle. ⚠ THE ORACLE COUNTS RATHER THAN PROBES: checking one
# coordinate would require the exact bitmap of one CP437 glyph to be right, which is a second thing to
# get wrong. A count does not care about the letterform.
fn count_col(sds, x0, y0, x1, y1, col): i64 {
    var n = 0;
    var yy = y0;
    while (yy < y1) {
        var xx = x0;
        while (xx < x1) {
            if (sd_surface_pixel_at(sds, xx, yy) == col) { n = n + 1; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    return n;
}

fn t_gt(a, b): i64 { if (a > b) { return 1; } return 0; }

fn mk_list(n, view_h): i64 {
    var lst = dh_list_new(20);
    var i = 0;
    while (i < n) {
        dh_list_add(lst, dh_widget_new(LABEL));
        i = i + 1;
    }
    dh_layout_apply(lst, 100, view_h);
    return lst;
}

fn main(): i64 {
    alloc_init();

    # ---- content shorter than the viewport ------------------------------------------------
    # ⛔ THE BOTTOM-EDGE BUG: 3 rows (60px) in a 100px viewport has max scroll 0, NOT -40. A
    # negative maximum lets the content scroll up off the top of a list that is not even full.
    var small = mk_list(3, 100);
    check(dh_list_content_h(small), 60);
    check(dh_list_max_scroll(small), 0);
    check(dh_list_scroll_to(small, 40), 0);          # refused — there is nowhere to go
    check(dh_widget_scroll_y(small), 0);

    # ---- content taller than the viewport -------------------------------------------------
    var lst = mk_list(10, 100);                      # 200px of content in 100px
    check(dh_list_content_h(lst), 200);
    check(dh_list_max_scroll(lst), 100);
    check(dh_list_scroll_to(lst, 40), 40);
    check(dh_list_scroll_to(lst, 999), 100);         # clamped to the end
    check(dh_list_scroll_to(lst, 0 - 5), 0);         # ...and to the start
    check(dh_list_scroll_by(lst, 30), 30);
    check(dh_list_scroll_by(lst, 0 - 100), 0);

    # ---- the scroll offset actually MOVES the rows ----------------------------------------
    # ⚠ Asserted through layout, not by reading the field back: the field being set proves nothing
    # about anything on screen. Row 0 sits at y=0 unscrolled and y=-40 scrolled by 40.
    dh_list_scroll_to(lst, 0);
    dh_layout_apply(lst, 100, 100);
    check(dh_widget_y(dh_list_row_at(lst, 0)), 0);
    check(dh_widget_y(dh_list_row_at(lst, 2)), 40);
    dh_list_scroll_to(lst, 40);
    dh_layout_apply(lst, 100, 100);
    check(dh_widget_y(dh_list_row_at(lst, 0)), 0 - 40);
    check(dh_widget_y(dh_list_row_at(lst, 2)), 0);

    # ---- selection ------------------------------------------------------------------------
    # ⛔ A FRESH LIST HAS NO SELECTION. 0 would mean every list boots claiming row 0 was chosen.
    var sel = mk_list(4, 100);
    check(dh_list_selected(sel), 0 - 1);
    check(dh_list_select(sel, 2), 2);
    check(dh_list_selected(sel), 2);
    check(dh_list_select(sel, 12), 0 - 1);           # out of range REFUSED...
    check(dh_list_selected(sel), 2);                 # ...and the old selection survives it
    check(dh_list_select(sel, 0 - 1), 0 - 1);        # -1 clears
    check(dh_list_selected(sel), 0 - 1);

    # Arrow movement CLAMPS (a held key stops at the end; it does not wrap).
    check(dh_list_move_sel(sel, 1), 0);              # from nothing -> the FIRST row...
    check(dh_list_move_sel(sel, 0 - 1), 0);          # ...and Up at the top stays put
    check(dh_list_move_sel(sel, 2), 2);
    check(dh_list_move_sel(sel, 99), 3);             # clamped to the last row, not wrapped
    check(dh_list_move_sel(sel, 1), 3);
    # From no selection, Up also lands on the first row — entering the list, not jumping to its end.
    dh_list_select(sel, 0 - 1);
    check(dh_list_move_sel(sel, 0 - 1), 0);
    # An empty list has nothing to move to and must not invent a selection.
    var empty = mk_list(0, 100);
    check(dh_list_move_sel(empty, 1), 0 - 1);
    check(dh_list_content_h(empty), 0);
    check(dh_list_max_scroll(empty), 0);

    # ---- ⭐⭐ keep-selected-visible: the no-op branch is the whole point ---------------------
    var k = mk_list(10, 100);                        # rows 0..9, 20px each, viewport 100 (5 rows)
    dh_list_select(k, 2);
    check(dh_list_scroll_to_sel(k), 0);              # row 2 spans 40..60 — ALREADY VISIBLE, no jump
    check(dh_widget_scroll_y(k), 0);
    dh_list_select(k, 4);
    check(dh_list_scroll_to_sel(k), 0);              # row 4 spans 80..100 — exactly the last visible
    dh_list_select(k, 5);
    check(dh_list_scroll_to_sel(k), 20);             # 100..120 -> minimum move: bottom to bottom
    dh_list_select(k, 9);
    check(dh_list_scroll_to_sel(k), 100);            # the end
    dh_list_select(k, 8);
    check(dh_list_scroll_to_sel(k), 100);            # still visible after that move — DO NOT scroll
    dh_list_select(k, 0);
    check(dh_list_scroll_to_sel(k), 0);              # far above -> its top to the viewport top
    # ⚠ And a middle row reached from BELOW parks at the top edge, not re-centred.
    dh_list_scroll_to(k, 100);
    dh_list_select(k, 3);
    check(dh_list_scroll_to_sel(k), 60);
    # With no selection at all, it must leave the offset alone rather than snapping to the top.
    dh_list_scroll_to(k, 40);
    dh_list_select(k, 0 - 1);
    check(dh_list_scroll_to_sel(k), 40);

    # `dh_list_step` is the pairing a key handler wants: move AND follow.
    dh_list_scroll_to(k, 0);
    dh_list_select(k, 4);
    check(dh_list_step(k, 1), 5);
    check(dh_widget_scroll_y(k), 20);

    # ---- ⛔ THE CLIP AGREEMENT: what you can see is what you can hit -----------------------
    # A row scrolled above the viewport keeps its real (negative) coordinates, so it is still a
    # rectangle containing points — the guard is that neither the painter nor the hit-test will
    # accept a point outside the LIST. Both halves asserted, because either one alone is a bug:
    # visible-but-dead (draw without clip) or dead-looking-but-live (hit without clip).
    var c = mk_list(10, 100);
    dh_list_scroll_to(c, 40);
    dh_layout_apply(c, 100, 100);
    check(dh_widget_y(dh_list_row_at(c, 0)), 0 - 40);   # row 0 is entirely above the viewport
    check(dh_list_index_at(c, 50, 0 - 30), 0 - 1);      # ...and a point on it misses
    check(dh_list_index_at(c, 50, 10), 2);              # row 2 (0..20 on screen) is what is there
    check(dh_list_index_at(c, 50, 150), 0 - 1);         # below the viewport entirely
    check(dh_list_index_at(c, 500, 10), 0 - 1);         # outside horizontally
    # And dh_hit_test agrees with dh_list_index_at — two derivations, one answer.
    check(dh_hit_test(c, 50, 10), dh_list_row_at(c, 2));
    check(dh_hit_test(c, 50, 0 - 30), 0);

    # ---- clipped painting -----------------------------------------------------------------
    # ⚠ Proven on PIXELS, not on the clip arithmetic in isolation: a row painted at a negative y
    # must leave the surface's top-left untouched. `dh_fill_rect_clip` is the unit under test and
    # a mutation to it that drops the clamp would paint here.
    var sds = sd_surface_new(40, 40);
    sd_clear(sds, 0x00000000);
    # A rect STRADDLING the clip's top edge: spans y 0..20, clipped to y 10..30 -> paints 10..20.
    dh_fill_rect_clip(sds, 0, 0, 40, 20, 0x00FF0000, 0, 10, 40, 20);
    check(sd_surface_pixel_at(sds, 5, 5), 0x00000000);      # in the rect, ABOVE the clip — cut
    check(sd_surface_pixel_at(sds, 5, 15), 0x00FF0000);     # in both — painted
    check(sd_surface_pixel_at(sds, 5, 25), 0x00000000);     # in the clip, BELOW the rect — untouched
    # A NEGATIVE origin is the scrolled-row case: spans y -10..20, unclipped -> paints 0..20 only.
    dh_fill_rect_clip(sds, 0, 0 - 10, 40, 30, 0x0000FF00, 0, 0, 40, 40);
    check(sd_surface_pixel_at(sds, 5, 5), 0x0000FF00);
    check(sd_surface_pixel_at(sds, 5, 25), 0x00000000);
    # A rect entirely outside its clip paints nothing at all.
    dh_fill_rect_clip(sds, 0, 30, 40, 10, 0x000000FF, 0, 0, 40, 10);
    check(sd_surface_pixel_at(sds, 5, 35), 0x00000000);

    # ---- ⭐⭐ THE SELECTION IS PAINTED BY THE TOOLKIT (0.9.8) -------------------------------
    # ⛔ 0.9.7 stored the selection and used it to scroll, and painted nothing — so a consumer still
    # set a background on the selected row by hand, which is the hand-rolling LIST exists to end.
    # ⚠ Pixel-level: "the container owns how the selection looks" is a claim about the screen.
    var p = mk_list(4, 80);
    var ps = sd_surface_new(60, 80);
    dh_widget_set_bounds(p, 0, 0, 60, 80);
    dh_layout_apply(p, 60, 80);
    # Nothing selected -> no highlight anywhere.
    dh_focus_set(0);
    sd_clear(ps, 0x00000000);
    dh_draw_widget(ps, p, 0, 0, 0, 60, 80);
    check(sd_surface_pixel_at(ps, 30, 10), 0x00000000);
    # Selected but NOT focused -> the muted line tint, not the accent.
    dh_list_select(p, 1);                        # row 1 spans y 20..40
    sd_clear(ps, 0x00000000);
    dh_draw_widget(ps, p, 0, 0, 0, 60, 80);
    check(sd_surface_pixel_at(ps, 30, 30), dh_theme_line());
    check(sd_surface_pixel_at(ps, 30, 10), 0x00000000);   # ...and only that row
    # Focused -> the accent. ⛔ Two panes both accented cannot answer "which one do my arrows drive".
    dh_focus_set(p);
    check(dh_focus_within(p), 1);
    sd_clear(ps, 0x00000000);
    dh_draw_widget(ps, p, 0, 0, 0, 60, 80);
    check(sd_surface_pixel_at(ps, 30, 30), dh_theme_accent());
    # Focus on a ROW still counts as the list being focused — it must not flicker to muted.
    dh_focus_set(dh_list_row_at(p, 2));
    check(dh_focus_within(p), 1);
    sd_clear(ps, 0x00000000);
    dh_draw_widget(ps, p, 0, 0, 0, 60, 80);
    check(sd_surface_pixel_at(ps, 30, 30), dh_theme_accent());
    # ⚠ A scrolled-away selection must not paint outside the viewport.
    var q = mk_list(10, 60);                     # 200px content, 60px viewport
    dh_focus_set(q);                             # ...focus THIS list, so its highlight is accented
    dh_widget_set_bounds(q, 0, 0, 60, 60);
    dh_list_select(q, 9);                        # the last row, far below
    dh_list_scroll_to(q, 0);                     # ...but scrolled to the top
    dh_layout_apply(q, 60, 60);
    var qs = sd_surface_new(60, 200);
    sd_clear(qs, 0x00000000);
    dh_draw_widget(qs, q, 0, 0, 0, 60, 200);
    check(sd_surface_pixel_at(qs, 30, 190), 0x00000000);  # row 9 is at y 180 — outside the list
    # ...and scrolling it into view paints it.
    dh_list_scroll_to_sel(q);
    dh_layout_apply(q, 60, 60);
    sd_clear(qs, 0x00000000);
    dh_draw_widget(qs, q, 0, 0, 0, 60, 200);
    check(sd_surface_pixel_at(qs, 30, 50), dh_theme_accent());

    # ⭐ A LIST TAKES KEYBOARD FOCUS — a list Tab cannot reach is a mouse-only control.
    check(dh_widget_focusable(p), 1);

    # ---- ⭐⭐ THE SELECTED ROW'S TEXT SURVIVES ITS OWN HIGHLIGHT (0.9.20, rupa 0.1.5) ----------
    # ⛔ THE HIGHLIGHT WAS ERASING THE ROW IT HIGHLIGHTED. The focused selection is filled with
    # `accent`, and every row's label was then drawn in the theme's primary `ink` — on MUDRA dark
    # that is 0xE7E9EF on 0x00E5FF, a contrast ratio of **1.27:1**. The one row the operator is
    # looking at was the one row that could not be read.
    # ⚠ COMPARE AGAINST THE BARE 0xRRGGBB, NOT `colour | 0xFF000000`. Glyph pixels really are stored
    # with alpha 0xFF (v0.9.2, load-bearing under agnos `#92` premultiplied src-over) — but
    # `sd_surface_pixel_at` rebuilds its answer from b/g/r only and drops the alpha byte, so a probe
    # never sees it. Expecting the alpha here fails against correct code.
    rupa_theme_set_active_name("mudra-dark");
    var r = dh_list_new(20);
    var r0 = dh_widget_new(LABEL);
    var r1 = dh_widget_new(LABEL);
    dh_widget_set_text(r0, "MMMM");
    dh_widget_set_text(r1, "MMMM");
    dh_list_add(r, r0);
    dh_list_add(r, r1);
    dh_widget_set_bounds(r, 0, 0, 60, 40);
    dh_layout_apply(r, 60, 40);
    dh_list_select(r, 0);
    dh_focus_set(r);
    var rs = sd_surface_new(60, 40);
    sd_clear(rs, 0x00000000);
    dh_draw_widget(rs, r, 0, 0, 0, 60, 40);
    var ink_px = dh_theme_ink();
    var oac_px = dh_theme_on_accent();
    # Row 0 is selected AND focused: its glyphs are on-accent, and NONE are plain ink.
    check(t_gt(count_col(rs, 0, 0, 60, 20, oac_px), 0), 1);
    check(count_col(rs, 0, 0, 60, 20, ink_px), 0);
    # ⛔ ROW 1 IS THE CONTROL, AND WITHOUT IT THE CHECK ABOVE PROVES NOTHING — a build that drew
    # EVERY label in on-accent would pass the first two lines and be just as broken.
    check(t_gt(count_col(rs, 0, 20, 60, 40, ink_px), 0), 1);
    check(count_col(rs, 0, 20, 60, 40, oac_px), 0);
    # ⚠ AND AN UNFOCUSED LIST MUST NOT SWAP THE INK. Its selection is filled with `line`, not accent,
    # and normal ink reads fine on `line` — so the swap is gated on focus exactly as the fill is.
    dh_focus_set(0);
    sd_clear(rs, 0x00000000);
    dh_draw_widget(rs, r, 0, 0, 0, 60, 40);
    check(t_gt(count_col(rs, 0, 0, 60, 20, ink_px), 0), 1);
    check(count_col(rs, 0, 0, 60, 20, oac_px), 0);

    # ---- the theme binding itself ------------------------------------------------------------
    check(dh_theme_on_accent(), sd_rgb(0x0B, 0x0C, 0x0E));   # mudra-dark: the carbon void
    rupa_theme_set_active_name("shanta-light");
    check(dh_theme_on_accent(), sd_rgb(0x2B, 0x26, 0x20));   # ...and it follows the active theme
    # ⚠ `faint` and `held` were published by rupa and never bound here until 0.9.20.
    check(dh_theme_faint(), sd_rgb(0xB3, 0xA8, 0x8F));
    check(dh_theme_held(), sd_rgb(0x6F, 0x7D, 0x5F));
    rupa_theme_set_active_name("mudra-dark");

    # ---- 0.9.26: the HORIZONTAL list ----------------------------------------------------------
    # ⛔⛔ WHY A HORIZONTAL LIST RATHER THAN A `MENU BAR` KIND. A menu bar, a tab strip, a toolbar and
    # a view switcher are all the same thing: a row of items, one current, the current one
    # highlighted. Composing that from a `BOX_H` of labels makes the APP paint the highlight — which
    # means the app naming `accent`, which crab's ADR 0001 forbids. The toolkit has to own it; it
    # does not need a new kind to. Same answer 0.9.23 gave MENU and SHEET, and it buys four surfaces.
    var hl = dh_list_new_h(40);
    check(dh_list_horizontal(hl), 1);
    check(dh_list_horizontal(dh_list_new(20)), 0);
    check(dh_list_horizontal(0), 0);
    # ⚠ THE MAIN-AXIS EXTENT IS THE WIDTH HERE. `dh_list_row_h` keeps its name and means "along this
    # list's own axis" as of 0.9.26 — renaming a public entry point in a patch would break every
    # consumer for a word.
    check(dh_list_row_h(hl), 40);
    var hi = 0;
    while (hi < 6) {
        var hc = dh_widget_new(LABEL);
        dh_list_add(hl, hc);
        hi = hi + 1;
    }
    check(dh_list_count(hl), 6);
    # ⛔ `dh_list_add` PINS THE MAIN AXIS. Pinning height here would leave every item auto-sized
    # while the scroll arithmetic — which multiplies by this number — described a layout that never
    # happened.
    check(dh_widget_pref_w(dh_list_row_at(hl, 0)), 40);
    dh_widget_set_gap(hl, 4);
    check(dh_list_content_h(hl), 6 * 40 + 5 * 4);      # six items, five gaps
    # ⛔⛔ SETTING THE LIST'S OWN PREF MUST NOT TOUCH ITS ITEM EXTENT. It did until 0.9.26: both lived
    # in `DH_W_PREF_*`, so sizing the container silently rewrote the row height and every scroll
    # figure derived from it. This test found it — `dh_list_row_h` answered 100 after a
    # `dh_widget_set_pref(hl, 100, 30)`. GRID had already given cells their own fields; LIST had not.
    dh_widget_set_pref(hl, 100, 30);
    check(dh_list_row_h(hl), 40);

    # A 100px-wide viewport over 260px of content.
    dh_layout_apply(hl, 100, 30);
    check(dh_list_max_scroll(hl), 260 - 100);
    # ⛔ THE OFFSET LANDS IN `DH_W_SCROLL_X`, NOT `_SCROLL_Y`. `layout.cyr` promised this field since
    # 0.9.7: a horizontal offset in a vertically-named field is a lie applied to the wrong axis.
    dh_list_scroll_to(hl, 50);
    check(dh_widget_scroll_x(hl), 50);
    check(dh_widget_scroll_y(hl), 0);
    # ...and layout really shifts the items left by it.
    dh_layout_apply(hl, 100, 30);
    check(dh_widget_x(dh_list_row_at(hl, 0)), 0 - 50);
    check(dh_widget_y(dh_list_row_at(hl, 0)), 0);      # ...and not vertically
    dh_list_scroll_to(hl, 0);
    dh_layout_apply(hl, 100, 30);
    check(dh_widget_x(dh_list_row_at(hl, 0)), 0);
    # ⛔ THE BOTTOM-EDGE CLAMP APPLIES ON THIS AXIS TOO — content shorter than the viewport gives a
    # negative maximum, and clamping to a negative scrolls content off the leading edge of a list
    # that is not even full. Every hand-rolled version in the stack had this bug vertically.
    var hs = dh_list_new_h(40);
    var hs1 = dh_widget_new(LABEL);
    dh_list_add(hs, hs1);
    dh_widget_set_pref(hs, 200, 30);
    dh_layout_apply(hs, 200, 30);
    check(dh_list_max_scroll(hs), 0);
    dh_list_scroll_to(hs, 500);
    check(dh_widget_scroll_x(hs), 0);

    # Keep-selected-visible works along the main axis, at MINIMUM move.
    dh_list_select(hl, 0);
    dh_list_scroll_to_sel(hl);
    check(dh_widget_scroll_x(hl), 0);
    dh_list_select(hl, 1);                              # item 1 spans 44..84, inside a 100 viewport
    dh_list_scroll_to_sel(hl);
    check(dh_widget_scroll_x(hl), 0);                   # ...so it does not move
    dh_list_select(hl, 5);                              # item 5 spans 220..260
    dh_list_scroll_to_sel(hl);
    check(dh_widget_scroll_x(hl), 260 - 100);
    dh_list_select(hl, 0);
    dh_list_scroll_to_sel(hl);
    check(dh_widget_scroll_x(hl), 0);

    # ⚠ SELECTION, INERT AND HIT-TESTING ARE DIRECTION-AGNOSTIC and are reused unchanged — the
    # index arithmetic never cared which way the items were laid out.
    dh_layout_apply(hl, 100, 30);
    check(dh_list_index_at(hl, 2, 2), 0);
    check(dh_list_index_at(hl, 46, 2), 1);
    check(dh_list_index_at(hl, 41, 2), 0 - 1);          # the gap belongs to nobody
    dh_widget_set_inert(dh_list_row_at(hl, 1), 1);
    check(dh_list_select(hl, 1), 0 - 1);                # an inert item is refused
    check(dh_list_index_at(hl, 46, 2), 0 - 1);          # ...and not clickable

    # ⛔ AND A VERTICAL LIST IS UNTOUCHED BY ALL OF IT — the additive guarantee. Its offset still
    # goes to `scroll_y` and its extent is still a height.
    var vl = dh_list_new(20);
    var vi = 0;
    while (vi < 6) { dh_list_add(vl, dh_widget_new(LABEL)); vi = vi + 1; }
    dh_widget_set_pref(vl, 100, 50);
    dh_layout_apply(vl, 100, 50);
    check(dh_list_row_h(vl), 20);                      # ...and a container pref did not eat it
    check(dh_widget_pref_h(dh_list_row_at(vl, 0)), 20);
    dh_list_scroll_to(vl, 30);
    check(dh_widget_scroll_y(vl), 30);
    check(dh_widget_scroll_x(vl), 0);

    var t = "list_test: ";
    print(t, strlen(t));
    fmt_int(g_checks);
    var t2 = " checks, ";
    print(t2, strlen(t2));
    fmt_int(g_fails);
    var t3 = " failed\n";
    print(t3, strlen(t3));
    return g_fails;
}

var rc = main();
syscall(60, rc);
