# programs/poll_test.cyr — RUN test for dh_client_poll_event / dh_setu_poll_event, the NON-BLOCKING
# half of the toolkit's input surface (0.9.11).
# Exit code = failed checks.
#
# ⭐ WHY BOTH SHAPES EXIST. `dh_client_next_event` BLOCKS. An app that only changes when input
# arrives is fine with that; one that redraws on its own — a file manager, a terminal — stalls on an
# idle connection. Offering only the blocking read is what pushed crab into a hand-rolled setu loop.
#
# ⚠ SEEDING THE BUFFER NEEDS NO FRAMES ON THE WIRE, BUT "IDLE" NEEDS A LIVE PEER. `setu_client_poll_input`
# drains the client's reassembly buffer BEFORE any syscall, so seeding that buffer exercises the real
# code path on a host. Once it is empty the poll goes to the fd, and the answer depends on what is there.
# ⛔ UNTIL 0.10.5 THESE CLIENTS HELD fd -1, and "nothing pending" held only because setu read -EBADF as
# idle — setu 0.8.11's bug, fixed there, and 3 checks here went red on it. Worse than those 3: the
# idle-allocation gate below does not read the poll's answer, so it would have stayed GREEN while
# measuring the error path instead of the idle one. ⇒ every client now shares the client end of a real
# pair whose peer stays open and silent: EAGAIN, which is what idle actually is.

include "src/lib.cyr"

var g_fails = 0;
var g_n = 0;

fn check(got, want): i64 {
    g_n = g_n + 1;
    if (got == want) { return 0; }
    g_fails = g_fails + 1;
    return 1;
}

# ⚠ Event accessors guarded: a regression that returns 0 (no event) where one was expected would
# otherwise SIGSEGV on the first deref and the suite would die instead of REPORTING which check
# failed. A crash is a signal; a failure count is a diagnosis.
fn ev_kind(e): i64 { if (e <= 0) { return 0 - 1; } return dh_event_kind(e); }
fn ev_a(e): i64    { if (e <= 0) { return 0 - 1; } return dh_event_a(e); }
fn ev_b(e): i64    { if (e <= 0) { return 0 - 1; } return dh_event_b(e); }

var g_live_fd = 0 - 1;      # client end of a pair whose peer stays open and silent (set in main)

# A connected pair of the socket setu speaks on Linux.
# -> a 16-byte record {client end, peer end}, or 0.
fn mk_pair(): i64 {
    var fds = alloc(8);
    if (sys_socketpair(SETU_AF_UNIX, SETU_SOCK_SEQPACKET, 0, fds) < 0) { return 0; }
    var p = alloc(16);
    store64(p, load32(fds));
    store64(p + 8, load32(fds + 4));
    return p;
}

# A client on `fd` with an empty reassembly buffer, ready for `seed`.
fn mk_client_on(fd): i64 {
    var c = alloc(SETU_C_SZ);
    var i = 0;
    while (i < SETU_C_SZ) { store8(c + i, 0); i = i + 1; }
    store64(c + SETU_C_FD, fd);
    store64(c + SETU_C_INBUF, alloc(SETU_C_INBUF_CAP));
    store64(c + SETU_C_INLEN, 0);
    return c;
}

# A client on the live pair: once its buffer is empty a poll reads EAGAIN, never EOF or an error.
fn mk_client(): i64 { return mk_client_on(g_live_fd); }

# Append one encoded message to the client's inbuf.
fn seed(c, msg): i64 {
    var ib = load64(c + SETU_C_INBUF);
    var len = load64(c + SETU_C_INLEN);
    var n = setu_encode(msg, ib + len, SETU_C_INBUF_CAP - len);
    if (n < 0) { return 0 - 1; }
    store64(c + SETU_C_INLEN, len + n);
    return n;
}

fn main(): i64 {
    alloc_init();
    var live = mk_pair();
    if (live == 0) { return 1; }
    g_live_fd = load64(live);

    # ---- an idle connection yields 0, and does NOT block ----------------------------------
    var idle = mk_client();
    check(dh_setu_poll_event(idle), 0);

    # ---- a buffered KEY frame comes back as a DhEvent ---------------------------------------
    var c = mk_client();
    seed(c, setu_input_key(7, 65, 1));
    var ev = dh_setu_poll_event(c);
    check(ev > 0, 1);
    check(ev_kind(ev), KEY);
    check(ev_a(ev), 65);                      # keysym
    check(ev_b(ev), 1);                       # press
    # ...and the buffer is now empty
    check(dh_setu_poll_event(c), 0);

    # ---- ⛔ A NON-INPUT FRAME IS CONSUMED AND THE POLL CONTINUES ----------------------------
    # Returning 0 on a non-input frame would read as "nothing pending" and stop a caller's drain
    # loop early, stranding frames already buffered behind it — the dropped-tail defect this
    # wrapper exists to avoid. The KEY below sits BEHIND a HELLO and must still arrive.
    var m = mk_client();
    seed(m, setu_hello(1, 0));                      # not an input frame
    seed(m, setu_input_key(7, 66, 1));
    var ev2 = dh_setu_poll_event(m);
    check(ev2 > 0, 1);
    check(ev_kind(ev2), KEY);
    check(ev_a(ev2), 66);                     # the key BEHIND the non-input frame

    # ---- draining several queued events in order ---------------------------------------------
    var d = mk_client();
    seed(d, setu_input_key(7, 97, 1));
    seed(d, setu_input_key(7, 98, 1));
    seed(d, setu_input_key(7, 99, 0));
    var e1 = dh_setu_poll_event(d);
    var e2 = dh_setu_poll_event(d);
    var e3 = dh_setu_poll_event(d);
    check(ev_a(e1), 97);
    check(ev_a(e2), 98);
    check(ev_a(e3), 99);
    check(ev_b(e3), 0);                       # ⚠ the RELEASE — the event a dropped tail loses
    check(dh_setu_poll_event(d), 0);                # drained

    # ---- dh_client_poll_event is the same thing on a DhClient --------------------------------
    var k = mk_client();
    seed(k, setu_input_key(7, 88, 1));
    var ke = dh_client_poll_event(k);
    check(ev_kind(ke), KEY);
    check(ev_a(ke), 88);

    # ---- ⛔⛔ SETU_CLOSE MUST SURVIVE THE POLL ------------------------------------------------
    # The compositor sends it when it removes a window. A client that keeps running holds its `#97`
    # channel end and its `#86` GPU-visible shm slot for the rest of the boot — 16 slots exist
    # system-wide, and the client's EXIT is what releases them. Before WINDOW_CLOSE was mapped, the
    # drain loop treated it as a non-input frame and CONSUMED IT SILENTLY, which would have
    # recreated the orphaned-client leak measured on the 2026-08-08 iron burn in every consumer
    # that adopted this poll.
    var q = mk_client();
    seed(q, setu_close(7));       # ⚠ CLOSE carries a surface id — a kind-only msg will not encode
    var qe = dh_setu_poll_event(q);
    check(qe > 0, 1);
    check(ev_kind(qe), WINDOW_CLOSE);
    # ...and it must not be reordered behind queued input either.
    var z = mk_client();
    seed(z, setu_input_key(7, 65, 1));
    seed(z, setu_close(7));
    check(ev_kind(dh_setu_poll_event(z)), KEY);
    check(ev_kind(dh_setu_poll_event(z)), WINDOW_CLOSE);

    # ---- ⭐ WINDOW_CONFIGURE: the compositor asking for a new size ---------------------------
    # ⛔ IT MUST SURVIVE THE POLL for the same reason CLOSE must: it is not an input frame, and a
    # drain loop that consumed it silently would leave the client frozen at its old extent forever
    # while the compositor clamped every blit. The size is the payload, not a notification.
    var cfg = mk_client();
    seed(cfg, setu_configure(7, 1280, 720, 0));
    var ce = dh_setu_poll_event(cfg);
    check(ev_kind(ce), WINDOW_CONFIGURE);
    check(ev_a(ce), 1280);
    check(ev_b(ce), 720);
    # ...and it must not be reordered behind queued input either.
    var cq = mk_client();
    seed(cq, setu_input_key(7, 65, 1));
    seed(cq, setu_configure(7, 800, 600, 0));
    check(ev_kind(dh_setu_poll_event(cq)), KEY);
    var c2 = dh_setu_poll_event(cq);
    check(ev_kind(c2), WINDOW_CONFIGURE);
    check(ev_a(c2), 800);

    # ---- ⭐ THE WHEEL REACHES A CLIENT AS ITS OWN KIND (0.9.18) ------------------------------
    # ⛔ IT MUST NOT ARRIVE AS A BUTTON. That is the X11 convention this deliberately does not copy —
    # a consumer range-checking `POINTER_BTN`'s code would treat a detent as a click.
    var scr = mk_client();
    seed(scr, setu_input_ptr_scroll(7, 3));
    var se = dh_setu_poll_event(scr);
    check(ev_kind(se), POINTER_SCROLL);
    check(ev_a(se), 3);
    check(ev_kind(se) == POINTER_BTN, 0);
    # ⚠ SIGN SURVIVES. A wheel-down arriving as a large positive would scroll a list to its end.
    var scr2 = mk_client();
    seed(scr2, setu_input_ptr_scroll(7, 0 - 2));
    check(ev_a(dh_setu_poll_event(scr2)), 0 - 2);
    # ⚠ ...and it does not displace input that was already queued.
    var scr3 = mk_client();
    seed(scr3, setu_input_key(7, 65, 1));
    seed(scr3, setu_input_ptr_scroll(7, 1));
    check(ev_kind(dh_setu_poll_event(scr3)), KEY);
    check(ev_kind(dh_setu_poll_event(scr3)), POINTER_SCROLL);

    # ---- ⭐⭐ AN IDLE POLL ALLOCATES NOTHING (0.9.16) ---------------------------------------
    # ⛔ THE DEFECT THIS GATES: `dh_setu_poll_event` called `setu_msg_new()` — 80 B — **before** it
    # knew whether anything was pending. `lib/alloc.cyr` has no `free()`, so an idle desktop grew the
    # heap once per wakeup forever, and anything repainting without input grew it at the repaint rate
    # (~4.8 KB/s at 60 Hz). It was the last unbounded per-cycle allocation in the render/input loop
    # after 0.9.13-0.9.15 took the frame itself to zero.
    # ⚠ WARM UP FIRST. The scratch message and the client's inbuf are both allocated on FIRST use, so
    # measuring from a cold client would report their one-time cost as a per-poll one — which is the
    # shape of measurement that makes a real fix look broken.
    var idle2 = mk_client();
    check(dh_setu_poll_event(idle2), 0);
    var p0 = alloc_used();
    var pi = 0;
    var not_idle = 0;
    while (pi < 200) {
        if (dh_setu_poll_event(idle2) != 0) { not_idle = not_idle + 1; }
        pi = pi + 1;
    }
    check(alloc_used() - p0, 0);                 # 200 idle polls, zero bytes
    check(not_idle, 0);                          # ...and they WERE idle, not the error path

    # ⚠ NON-VACUITY: the same loop against a client that DOES have frames must still cost something,
    # or a zero above would only prove the poll did nothing. An event is a real `dh_event_new`.
    var busy = mk_client();
    seed(busy, setu_input_key(7, 65, 1));
    dh_setu_poll_event(busy);                    # warm the inbuf
    seed(busy, setu_input_key(7, 66, 1));
    var b0 = alloc_used();
    check(ev_kind(dh_setu_poll_event(busy)), KEY);
    check(alloc_used() - b0 > 0, 1);             # an event still allocates — only the IDLE path is free

    # ⚠ A CONFIGURE followed by a CLOSE through the SHARED scratch — the sequence that would expose
    # stale args if anything read past `argc`.
    # ⛔ THESE CHECKS DO **NOT** PIN THE SCRATCH'S ZEROING, AND SAYING SO IS THE POINT. They were
    # written believing they did; mutation says otherwise — removing the zeroing from
    # `dh_setu_msg_scratch` leaves this file green. It cannot fail, because `dh_setu_map_input` maps
    # `SETU_CLOSE` with a literal `a = 0; b = 0;` rather than by reading the message, and every kind
    # that DOES read an arg has that arg guaranteed present by `setu_decode`'s argc-vs-kind check.
    # ⇒ The zeroing is **unexercised defence, measured not assumed**: it removes a dependency on
    # setu's argc validation staying correct, and costs ten stores. What these lines really pin is
    # the mapping and the ordering across a reused buffer, which is worth having on its own.
    var reuse = mk_client();
    seed(reuse, setu_configure(7, 1280, 720, 0));
    seed(reuse, setu_close(7));
    check(ev_a(dh_setu_poll_event(reuse)), 1280);
    var ce2 = dh_setu_poll_event(reuse);
    check(ev_kind(ce2), WINDOW_CLOSE);
    check(ev_a(ce2), 0);
    check(ev_b(ce2), 0);

    # ---- ⛔⛔ A COMPOSITOR THAT GOES AWAY IS REPORTED (0.10.5, setu 0.8.11) --------------------
    # The header has promised -6 on EOF since the poll was written, and on Linux it never came: every
    # recvfrom that was not a record read as "nothing pending", so a client whose compositor crashed
    # without sending SETU_CLOSE polled a dead channel forever. crab's "connection closed" exit is
    # reached through this call, and on Linux could not fire.
    var gone = mk_pair();
    var gc = mk_client_on(load64(gone));
    check(dh_client_poll_event(gc), 0);                       # live and silent is idle, not gone
    setu_send(load64(gone + 8), setu_input_key(7, 65, 1));    # one frame in flight...
    setu_send(load64(gone + 8), setu_hello(1, 0));            # ...a non-input frame behind it...
    sys_close(load64(gone + 8));                              # ...and the peer is gone.
    check(ev_kind(dh_client_poll_event(gc)), KEY);            # ⚠ what arrived first still arrives
    check(dh_client_poll_event(gc), 0 - 6);                   # the HELLO is consumed, then EOF
    # ⛔ -6 IS FINAL: it does not decay back to 0. A drain loop written "until 0" spins here, which
    # is why dh_client_poll_event's header says WHILE > 0.
    check(dh_client_poll_event(gc), 0 - 6);
    check(dh_client_next_event(gc), 0 - 6);                   # the blocking read sees it too, at once

    # A close with one of the client's records unread is a RESET, not an EOF, and must read the same.
    var rst = mk_pair();
    var rc2 = mk_client_on(load64(rst));
    setu_send(load64(rst), setu_commit(1));
    sys_close(load64(rst + 8));
    check(dh_client_poll_event(rc2), 0 - 6);

    # An fd that was never a connection is an error too, not an idle channel.
    check(dh_setu_poll_event(mk_client_on(0 - 1)), 0 - 6);

    return g_fails;
}

var rc = main();
syscall(60, rc);
