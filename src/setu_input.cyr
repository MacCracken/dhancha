# dhancha — setu input adapter: setu INPUT_* wire messages → DhEvents.
#
# The "compositor-fd input source" the sovereign-desktop doc describes: the
# client reads input frames off the setu transport and feeds them as DhEvents
# into the toolkit's dispatch (dh_run's DhQueue). Bridges event.cyr (DhEvent) +
# setu (the wire) + setu_client.cyr (the transport) — include it alongside
# src/lib.cyr + src/setu_client.cyr. Bite 11 wires dh_setu_read_event into
# dh_run's loop; here it's the standalone seam.

# Map a decoded setu INPUT_* message `m` to a fresh DhEvent (*DhEvent), or 0 if
# `m` is not an input message. The (a,b) payload maps 1:1 onto DhEvent:
#   INPUT_KEY(id,keysym,mods) → KEY(a=keysym, b=mods)
#   INPUT_PTR_MOVE(id,x,y)    → POINTER_MOVE(a=x, b=y)
#   INPUT_PTR_BTN(id,btn,st)  → POINTER_BTN(a=btn, b=st)
#   INPUT_FOCUS(id,focused)   → FOCUS(a=focused, b=0)
fn dh_setu_map_input(m): i64 {
    var k = setu_msg_kind(m);
    var dk = 0 - 1;
    var a = 0;
    var b = 0;
    if (k == SETU_INPUT_KEY)        { dk = KEY;          a = setu_msg_arg(m, 1); b = setu_msg_arg(m, 2); }
    elif (k == SETU_INPUT_PTR_MOVE) { dk = POINTER_MOVE; a = setu_msg_arg(m, 1); b = setu_msg_arg(m, 2); }
    elif (k == SETU_INPUT_PTR_BTN)  { dk = POINTER_BTN;  a = setu_msg_arg(m, 1); b = setu_msg_arg(m, 2); }
    elif (k == SETU_INPUT_FOCUS)    { dk = FOCUS;        a = setu_msg_arg(m, 1); b = 0; }
    elif (k == SETU_CLOSE)          { dk = WINDOW_CLOSE; a = 0; b = 0; }
    elif (k == SETU_CONFIGURE)      { dk = WINDOW_CONFIGURE; a = setu_msg_arg(m, 1); b = setu_msg_arg(m, 2); }
    else { return 0; }
    var ev = dh_event_new(dk);
    store64(ev + DH_E_A, a);
    store64(ev + DH_E_B, b);
    return ev;
}

# ============================================================================================
# ⭐⭐ ONE SCRATCH MESSAGE FOR THE PROCESS (0.9.16) — the last unbounded per-cycle allocation
# ============================================================================================
# ⛔ THE DEFECT: `dh_setu_poll_event` called `setu_msg_new()` — an 80-byte `alloc` — **before it knew
# whether anything was pending**, so an idle desktop paid 80 B for every poll that found nothing, into
# a bump allocator with no `free()`. crab's event loop polls once per iteration and waits on
# `sys_pause` when idle, so the cost tracked wakeups; anything that repaints without input tracks the
# repaint rate, and at 60 Hz that is ~4.8 KB/s of permanent growth forever.
#
# ⭐ IT WAS THE LAST ONE. crab's frame went to zero bytes across 0.9.13–0.9.15; this is the other half
# of the render/input loop, and with it the whole loop allocates nothing in steady state. That is what
# makes a self-repainting element — an idle animation, a transfer progress bar, an index counter —
# affordable rather than a slow leak.
#
# ⇒ The message is PURE SCRATCH: `setu_client_poll_input` fills it and `dh_setu_map_input` reads it to
# build a **separate** `DhEvent`. Nothing retains it past the call, so one per process is enough.
# ⚠ NOT ON THE FRAME ARENA, AND THIS IS THE TRAP WORTH NAMING. The obvious move — route it through
# `dh_falloc` — is WRONG: polling happens in the event loop, `dh_frame_begin` rewinds the arena inside
# the caller's render, and the scratch would be freed out from under a loop that is still using it.
# Per-frame and per-poll are different lifetimes. It stays on the global allocator, allocated once.
# ⚠ IT IS ZEROED ON EVERY HAND-OUT rather than merely reused — and that is UNEXERCISED DEFENCE, stated
# rather than implied. `setu_decode` writes only the args a kind actually carries, so a reused buffer
# keeps the previous frame's tail. Nothing can observe it: `dh_setu_map_input` maps `SETU_CLOSE` with a
# literal `a = 0`, and every kind that reads an arg has it guaranteed by `setu_decode`'s argc-vs-kind
# check. **Deleting the zeroing does not fail `poll_test` — measured, not assumed.** It is kept because
# it removes a dependency on setu's argc validation staying correct, at a cost of ten stores; if that
# validation is ever relaxed, this is what stops a stale tail becoming a wrong event.
var _dh_msg_scratch = 0;

# @public — the toolkit's per-process scratch `SetuMsg`, zeroed and ready. Allocated on first use.
# Valid only until the next call: it is one buffer, and every caller here consumes it immediately.
fn dh_setu_msg_scratch(): i64 {
    if (_dh_msg_scratch == 0) {
        _dh_msg_scratch = setu_msg_new();
        return _dh_msg_scratch;
    }
    var m = _dh_msg_scratch;
    if (m == 0) { return 0; }
    store64(m + SETU_MSG_KIND, 0);
    store64(m + SETU_MSG_ARGC, 0);
    var i = 0;
    while (i < SETU_MAX_ARGS) {
        store64(m + SETU_MSG_ARGS + i * 8, 0);
        i = i + 1;
    }
    return m;
}

# Read one setu frame off `fd` (exact framing) and map it to a DhEvent. Returns
# the DhEvent (*DhEvent, > 0), 0 on a non-input frame, or -6 on EOF / recv error.
# The seam the compositor-fd loop in dh_run will pump.
fn dh_setu_read_event(fd): i64 {
    var m = dh_setu_msg_scratch();          # 0.9.16 — one per process, not one per call
    if (m == 0) { return 0 - 6; }
    if (dh_setu_read_msg(fd, m) < 0) { return 0 - 6; }
    return dh_setu_map_input(m);
}

# @public — NON-BLOCKING sibling of `dh_setu_read_event`. -> a *DhEvent (> 0), 0 when nothing is
# pending, or -6 on EOF.
#
# ⭐⭐ WHY THE TOOLKIT OWES BOTH SHAPES. `dh_setu_read_event` BLOCKS: it waits for a frame. That is
# right for an app whose display only changes when input arrives, and wrong for one that redraws on
# its own — a file manager repainting a selection, a terminal draining a pty. Offering only the
# blocking read forced every such consumer to reach past the toolkit to setu, which is exactly how
# crab ended up with a hand-rolled input loop while using dhancha for pixels.
#
# ⛔ IT WRAPS `setu_client_poll_input`, NOT `setu_poll_input`, AND THAT IS A BUG FIX, NOT A DETAIL.
# setu's own header on the latter: it "decodes only the FIRST frame of each recv; coalesced or split
# frames are dropped ... kept for API compat", and dropping a coalesced tail LOSES KEY-RELEASE
# EVENTS, which sticks keys for FULL_KEYS consumers. The reassembling call buffers the remainder in
# the client and hands out one frame per call. Any consumer moving off a hand-rolled
# `setu_poll_input` loop onto this gains that fix by adopting.
#
# ⚠ A NON-INPUT FRAME IS CONSUMED AND THE POLL CONTINUES, rather than returning 0. Returning 0 there
# would read as "nothing pending" and stop a caller's drain loop early, stranding frames that were
# already buffered — the same class of dropped-tail defect this wraps around.
fn dh_setu_poll_event(c): i64 {
    # ⚠ HOISTED (0.9.16). This was `setu_msg_new()` — 80 B allocated before the poll knew whether
    # anything was pending. See the ⛔ block above `_dh_msg_scratch`.
    var m = dh_setu_msg_scratch();
    if (m == 0) { return 0 - 6; }
    var spinning = 1;
    while (spinning == 1) {
        var r = setu_client_poll_input(c, m);
        if (r == 0) { return 0; }          # nothing pending
        if (r < 0) { return r; }           # -6 EOF
        var ev = dh_setu_map_input(m);
        if (ev != 0) { return ev; }        # an input frame -> hand it over
        # a consumed non-input frame: keep draining
    }
    return 0;
}
